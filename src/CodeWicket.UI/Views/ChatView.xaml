<UserControl x:Class="CodeWicket.UI.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CodeWicket.UI.ViewModels"
             xmlns:conv="clr-namespace:CodeWicket.UI.Converters"
             xmlns:md="clr-namespace:CodeWicket.UI.Markdown"
             xmlns:controls="clr-namespace:CodeWicket.UI.Controls"
             xmlns:views="clr-namespace:CodeWicket.UI.Views"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="500" d:DesignWidth="380"
             PreviewKeyDown="ZoomShortcut_PreviewKeyDown"
             AllowDrop="True"
             PreviewDragEnter="Chat_PreviewDragOver"
             PreviewDragOver="Chat_PreviewDragOver"
             PreviewDrop="Chat_PreviewDrop"
             Background="{DynamicResource Chat.Background}"
             FontFamily="{DynamicResource Chat.FontFamily}"
             FontSize="{DynamicResource Chat.FontSize}"
             TextElement.Foreground="{DynamicResource Chat.Foreground}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CodeWicket.UI;component/Themes/DefaultTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:NullOrEmptyToVisibilityConverter x:Key="NullToCollapsed" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisible" />
            <BooleanToVisibilityConverter x:Key="BoolToVisible" />
            <conv:PercentToArcConverter x:Key="PercentToArc" Diameter="11" />

            <!-- Both conversation lists in the history picker. They VIRTUALIZE, and that is a
                 measured fix rather than hygiene: a plain ItemsControl realises every row, so
                 refilling the bound collection cost 1,660-2,407ms of the ~1,750-2,530ms an open took
                 (measured 2026-09-04 by the [history] trace, 57 saved rows + 26 backend rows).

                 The first open was CHEAP and every later one expensive, which is the tell: on the
                 first the popup's content has never been realised, so the adds land on a control with
                 no containers and the work shows up later as layout. From the second the Popup still
                 holds its visual tree, so Clear() tears down 57 realised containers and every Add
                 synchronously generates a new one.

                 THE TEMPLATE IS HALF THE FIX. Each pane used to be ScrollViewer > StackPanel >
                 ItemsControl, and a StackPanel measures its child at INFINITE height - so there is no
                 viewport, and virtualization silently does nothing however it is configured. Setting
                 the panel alone would have looked like a fix and changed nothing. The ItemsControl now
                 owns its own ScrollViewer and the panes are DockPanels, which is what gives it a
                 bounded height under the DockPanel MaxHeight="380" below. -->
            <Style x:Key="Chat.SessionList" TargetType="ItemsControl">
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" Focusable="False" Padding="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One label/value row, shared by BOTH status-strip readout panels (usage and the MCP
                 roster). Shared rather than copied so the two cannot drift into looking like
                 different products; a sub-item is indented detail under the row above it. The session
                 card (#160) shares the TYPE and keeps its own template - it is a properties list, with
                 the emphasis the other way round, which is a real difference rather than drift.

                 The chevron column is Auto and its button collapses, so a row that cannot expand
                 occupies exactly the width it did before this existed - the usage panel is untouched
                 by the MCP roster's tree. -->
            <DataTemplate x:Key="DetailRowTemplate" DataType="{x:Type vm:DetailRow}">
                <Grid x:Name="row" Margin="0,1" ToolTip="{Binding Tooltip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The label block: indent, then a FIXED chevron slot, then the text. Every part
                         of this is in ONE cell deliberately. Each row is its own Grid, so an Auto
                         column is sized per row and not across the list - a chevron in its own column
                         made every row without one shift left, and the tree came out ragged. The slot
                         is Hidden rather than Collapsed for the same reason: it must hold its width on
                         rows that have no chevron, or their labels sit 14px left of their siblings. -->
                    <StackPanel Grid.Column="0" x:Name="labelBlock" Orientation="Horizontal">
                        <!-- Click is handled in code-behind, not bound: RelayCommand discards its
                             parameter, so a CommandParameter binding would compile and toggle nothing. -->
                        <Button x:Name="chevron" Click="McpRowChevron_Click"
                                Focusable="False" Cursor="Hand" Padding="0" Width="14"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Label}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <!-- A drawn triangle, not a font glyph: a missing codepoint
                                             renders as a box and no assertion can tell that from a
                                             real icon (the screenshot-permission rule). -->
                                        <Path x:Name="arrow" Data="M 0,0 L 4,3.5 L 0,7 Z"
                                              Width="5" Height="8" Stretch="None"
                                              Fill="{DynamicResource Chat.SubtleForeground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- The whole transform is replaced rather than an Angle set
                                             on a named one: a RenderTransform's name is not a
                                             template-child name, so TargetName cannot reach it. -->
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter TargetName="arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="arrow" Property="Fill"
                                                    Value="{DynamicResource Chat.Foreground}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpandable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- Collapsed, not Hidden: a heading sits outside the gutter
                                             entirely. In this Style rather than the template's
                                             triggers because a Style setter wins over one. -->
                                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock x:Name="label" Text="{Binding Label}" TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSubItem}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Chat.SubtleForeground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="value" Text="{Binding Value}" Margin="12,0,0,0"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource Chat.Foreground}" />
                </Grid>
                <DataTemplate.Triggers>
                    <!-- Indent is one slot-width per level, applied to the whole label block so the
                         chevron travels with its own row rather than staying in a fixed gutter. -->
                    <DataTrigger Binding="{Binding Depth}" Value="1">
                        <Setter TargetName="labelBlock" Property="Margin" Value="14,0,0,0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Depth}" Value="2">
                        <Setter TargetName="labelBlock" Property="Margin" Value="28,0,0,0" />
                    </DataTrigger>

                    <!-- A section subtitle: flush LEFT, outside the chevron gutter its rows sit in, so
                         it reads as naming the group rather than as another member of it. The slot is
                         Collapsed here and Hidden everywhere else - the one row that must NOT reserve
                         the gutter is the one that is not in the list it heads. Spacing above, none
                         below, so it binds to what follows rather than floating between the two. -->
                    <DataTrigger Binding="{Binding IsHeading}" Value="True">
                        <Setter TargetName="row" Property="Margin" Value="0,6,0,1" />
                        <Setter TargetName="label" Property="Foreground"
                                Value="{DynamicResource Chat.SubtleForeground}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsMonospace}" Value="True">
                        <Setter TargetName="value" Property="FontFamily"
                                Value="{DynamicResource Chat.CodeFontFamily}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Shared zoom scale: one instance applied as the LayoutTransform of both the transcript
                 and the input/banner rows, so Ctrl+MouseWheel zooms the whole conversation surface
                 (content re-wraps at the scaled size) while the header pickers stay fixed as chrome. -->
            <ScaleTransform x:Key="ZoomTransform" />

            <!-- Resize grip for the message box: a hit-testable strip along its top edge that drags
                 the box taller. Invisible at rest (the input shouldn't grow permanent chrome for a
                 gesture most turns never need) and shows a short bar on hover/drag, the same
                 affordance VS gives its own splitters. The template's outer Background must be a
                 real brush — a null one doesn't hit-test, and the strip would be undraggable. -->
            <Style x:Key="Chat.InputResizeGrip" TargetType="Thumb">
                <Setter Property="Height" Value="6" />
                <Setter Property="Cursor" Value="SizeNS" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                                <Rectangle x:Name="Bar" Width="28" Height="2" RadiusX="1" RadiusY="1"
                                           Fill="Transparent" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Chat.SubtleForeground}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Chat.InputBorderFocus}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Card border shared by the tool + edit rows. Background/border live in the style (not as
                 local attributes) so the IsHighlighted trigger can override them: while a pending
                 permission prompt refers to this row, it gets an accent outline so the user can see which
                 transcript entry they're being asked about. Reverts when the prompt is dismissed. -->
            <Style x:Key="Chat.RowBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Chat.ToolBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Chat.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Chat.InputBorderFocus}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- How a call came to be permitted, in four marks: you decided, it was refused, it was
                 allowed without asking you, we have no record. Nothing is drawn for the commonest state
                 (the backend never asked), so silence means exactly that and a 26-call fan-out gains 26
                 nothings. Anything finer than the four — which rule, saved or session, rule or mode — is
                 the tooltip's job: a mark a reader has to learn is worse than a sentence they can read.

                 SHARED by the tool row and the edit card, because an edit that renders as a card has no
                 tool row to carry the mark and must not therefore say less about permission than the same
                 edit does on a backend that opens a row first. Two copies of this would be two things to
                 keep in step, and the copy on the rarer path is the one that would rot.

                 TWO CHANNELS, ONE AXIS EACH: the glyph says who decided, the colour says what happened.
                 Green covers both allows and red both refusals — "allowed" is the same outcome however it
                 was reached, and the mark beside it already says how. EVERY tone the view-model emits is
                 matched, so an unmatched one is obviously missing rather than silently taking the
                 default; that default is unreachable by construction and stays as the fallback for a tone
                 added later without a trigger.

                 Size and weight are set for the LIGHTEST marks, not the heaviest: at a common point size
                 the tick and cross carry far more ink than the guillemet, so matching point size does not
                 match apparent size and the thin mark reads as stray punctuation. SemiBold closes part of
                 that gap; the guillemet needed the rest in SIZE, measured by eye against a real
                 transcript, hence the one per-tone override below. Glyphs are chosen for having NO emoji
                 presentation — one that does renders from whichever font the machine happens to serve it
                 from. -->
            <Style x:Key="Chat.PermissionGlyph" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource Chat.SubtleForeground}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PermissionGlyphTone}" Value="Allowed">
                        <Setter Property="Foreground" Value="{DynamicResource Chat.SuccessForeground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PermissionGlyphTone}" Value="Auto">
                        <Setter Property="Foreground" Value="{DynamicResource Chat.SuccessForeground}" />
                        <!-- The guillemet alone runs 2pt larger. It is the lightest of the four marks and
                             the one seen most often, so it is the one that has to hold its own beside a
                             tick — and it is a SIZE fix rather than a weight one because SemiBold had
                             already been spent. Sizing every mark up to suit it would make the tick and
                             cross shout. -->
                        <Setter Property="FontSize" Value="16" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PermissionGlyphTone}" Value="Denied">
                        <Setter Property="Foreground" Value="{DynamicResource Chat.ErrorForeground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PermissionGlyphTone}" Value="Unknown">
                        <Setter Property="Foreground" Value="{DynamicResource Chat.WarningForeground}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- User bubble width. The fraction is what reads as "this message is mine" (a right-hand
                 gutter next to the full-width assistant text), and it holds at any window size. The
                 floor is the one bound: a narrow dock, where 75% would wrap every prompt into a ragged
                 column.

                 There is deliberately NO ceiling. A line-length cap was tried and dropped, because the
                 assistant column beside it is unbounded — it's full panel width, and carries the longer
                 prose of the two — so capping only the user bubble fixed the smaller half of a
                 readability problem while making the transcript inconsistent with itself. Bounding both
                 (one measure for the whole column, as claude.ai/ChatGPT do) is the coherent alternative
                 and was weighed; it was declined as too strong a change for a VS tool window, where
                 Copilot renders full-width and the column carries code, tables and wide cards. So: if a
                 cap ever comes back, it belongs on the transcript column, not on this one item type.
                 See ProportionalWidthConverter. Tune here. -->
            <conv:ProportionalWidthConverter x:Key="UserBubbleMaxWidth" Fraction="0.75" Minimum="320" />

            <!-- Attachments (issue #118). Two templates rather than one with triggers, because the two
                 places an attachment appears want genuinely different things: the composer's chip is a
                 control the user acts on (name, size, a remove button), while the bubble's is a picture
                 of something already said and wants no chrome competing with it.

                 Both degrade to a labelled chip when there is no thumbnail — an unsupported codec, or a
                 restored message whose file retention has since reclaimed. Dropping the item instead
                 would have the transcript quietly claim the message carried no image when it did. -->
            <DataTemplate x:Key="Chat.AttachmentChip" DataType="{x:Type vm:AttachmentViewModel}">
                <Border Margin="0,0,4,0" Padding="4" CornerRadius="4"
                        Style="{StaticResource Chat.RowBorder}" ToolTip="{Binding Name}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                               StretchDirection="DownOnly" MaxWidth="40" MaxHeight="32"
                               Margin="0,0,6,0"
                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisible}}" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock Text="{Binding Name}" FontSize="11" MaxWidth="140"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Chat.Foreground}" />
                            <TextBlock Text="{Binding SizeLabel}" FontSize="10"
                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                        </StackPanel>
                        <!-- Only where it can act: a chip in the tray belongs to a message already
                             taken, and its images go or stay with it. -->
                        <Button Command="{Binding RemoveCommand}" Content="✕"
                                Style="{StaticResource Chat.IconButton}" VerticalAlignment="Center"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisible}}"
                                ToolTip="Remove this attachment" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Attached IDE context (issue #73, rung 2). ONE template for the composer and the
                 bubble, unlike the two an image gets: a capture looks the same wherever it is, and
                 the only thing that differs is whether it can be removed - which the chip already
                 keys off CanRemove. The text is plain and selectable, NEVER markdown: frame names,
                 paths and values must survive verbatim, which is the rule the error Details panel
                 is written under.

                 Collapsed by default and expanded in place. A stack trace is a wall, and the chip's
                 job is to say what is attached rather than to show it - but the user is entitled to
                 read exactly what they are about to hand over, so the whole text is one click away
                 and is not cut. -->
            <DataTemplate x:Key="Chat.ContextChip" DataType="{x:Type vm:ContextItemViewModel}">
                <!-- Padding matched to Chat.ChipButton's (the "Add" pill beside it), so the two sit
                     the same height and their text lines up under the WrapPanel's top alignment. They
                     did not: the label below took Chat.SubtleButton whole, whose 1px border drew a
                     second box INSIDE the chip and whose 10,3 padding made the chip stand taller than
                     the pill. Both were visible the moment a real one was looked at (in Visual Studio, 2026-08-26)
                     and neither is reachable by assertion. -->
                <Border Margin="0,0,4,4" Padding="6,2" CornerRadius="4"
                        Style="{StaticResource Chat.RowBorder}" ToolTip="{Binding Peek}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- The label IS the control, so it needs the button's behaviour and none
                                 of its chrome: no border (the chip already has one) and no padding of
                                 its own. -->
                            <Button Command="{Binding ToggleExpandCommand}"
                                    Style="{StaticResource Chat.SubtleButton}"
                                    BorderThickness="0" Padding="0" VerticalAlignment="Center"
                                    ToolTip="Show exactly what will be sent">
                                <TextBlock Text="{Binding Label}" FontSize="11" MaxWidth="260"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Chat.Foreground}" />
                            </Button>
                            <!-- Padding 2, not the style's 4: at 4 the remove button alone set the
                                 chip's height and put it out of line with the pill again. -->
                            <Button Command="{Binding RemoveCommand}" Content="&#x2715;"
                                    Style="{StaticResource Chat.IconButton}" VerticalAlignment="Center"
                                    Padding="2" FontSize="11" Margin="4,0,0,0"
                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisible}}"
                                    ToolTip="Remove this context" />
                        </StackPanel>
                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
                                 Margin="2,4,2,2" MaxHeight="220" FontSize="11"
                                 FontFamily="{DynamicResource Chat.CodeFontFamily}"
                                 Background="Transparent" BorderThickness="0"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Foreground="{DynamicResource Chat.SubtleForeground}"
                                 Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="Chat.AttachmentThumb" DataType="{x:Type vm:AttachmentViewModel}">
                <Border Margin="0,0,4,4" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource Chat.Border}" ToolTip="{Binding Name}">
                    <Grid>
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                               StretchDirection="DownOnly" MaxWidth="240" MaxHeight="180"
                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisible}}" />
                        <!-- The file is gone (or was never decodable): name it rather than show a hole. -->
                        <TextBlock Text="{Binding Name}" Margin="8,6" FontSize="11"
                                   Foreground="{DynamicResource Chat.SubtleForeground}"
                                   Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisible}}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Message bubble (user / assistant / thinking) -->
            <DataTemplate DataType="{x:Type vm:MessageItemViewModel}">
                <!-- A mid-turn delivery carries a short framing block the user did not write, so the
                     bubble says so on hover. The words we add are ours; the user is entitled to see
                     that we added them. Null on an ordinary send, and a null ToolTip simply does not
                     show - no trigger needed. -->
                <Border Margin="6,4" Padding="9,7" CornerRadius="6"
                        ToolTip="{Binding DeliveryNote}"
                        Background="{DynamicResource Chat.AssistantBackground}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Chat.UserBackground}" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <!-- Proportional, not the old fixed 320: the transcript is the width
                                         source (it sits inside the zoom LayoutTransform, so these bounds
                                         stay in pre-zoom units and scale with Ctrl+MouseWheel as before). -->
                                    <Setter Property="MaxWidth"
                                            Value="{Binding ActualWidth,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                    Converter={StaticResource UserBubbleMaxWidth}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                    <!-- Images sent with the message, above its text — the order they were assembled in,
                         and the order they reach the agent. Assistant bubbles never have any, so the
                         strip collapses to nothing on all but the user's own. -->
                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,4"
                                  ItemTemplate="{StaticResource Chat.AttachmentThumb}"
                                  Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- IDE context sent with the message, above its text like the images - it is
                         part of what was said, and the bubble is the durable record of that. Collapsed,
                         so a transcript full of captures still reads as a conversation. -->
                    <ItemsControl ItemsSource="{Binding Contexts}" Margin="0,0,0,4"
                                  ItemTemplate="{StaticResource Chat.ContextChip}"
                                  Visibility="{Binding HasContexts, Converter={StaticResource BoolToVisible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid>
                        <!-- Assistant text: rendered markdown (bold/code/lists/headings/links), selectable
                             + copyable via the hosted FlowDocumentScrollViewer, re-rendered as deltas
                             stream in (md:MarkdownText.Text). Only bound/shown for the assistant role. -->
                        <FlowDocumentScrollViewer PreviewMouseWheel="ForwardWheelToTranscript">
                            <!-- Replaces the viewer's default menu with one smart "Copy": copies the
                                 selection when there is one, else the whole message without selecting
                                 first (the old "Copy all", folded in) — same affordance as the rows. -->
                            <FlowDocumentScrollViewer.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Click="CopyBlock_Click" />
                                </ContextMenu>
                            </FlowDocumentScrollViewer.ContextMenu>
                            <FlowDocumentScrollViewer.Style>
                                <Style TargetType="FlowDocumentScrollViewer" BasedOn="{StaticResource Chat.MarkdownDocument}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <!-- Links BEFORE Text, and the order is load-bearing (issue #86).
                                                 A render with no link context resolves nothing - the renderer
                                                 never touches the disk, so with _links null every reference
                                                 renders as plain text whether or not its answer is cached, and
                                                 nothing is even recorded as pending. Setting Text first
                                                 therefore built the whole document WITHOUT links, then rebuilt
                                                 it with them ~100ms later: two full render passes where one
                                                 would do, and on a large message each of those is its own
                                                 second-long pass. It was visible, too - the user reported
                                                 filenames flashing white and turning blue after a pause.
                                                 Reversed, the first render has no TEXT yet, so it costs an
                                                 empty document instead of a wasted one.
                                                 Sourced from the ChatView's own DataContext (the ChatViewModel)
                                                 because the row's is the message; null in hosts with no editor
                                                 to open, which is why "no links" has to stay a legal render. -->
                                            <Setter Property="md:MarkdownText.Links"
                                                    Value="{Binding DataContext.FileLinks,
                                                            RelativeSource={RelativeSource AncestorType=views:ChatView}}" />
                                            <Setter Property="md:MarkdownText.Text" Value="{Binding Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </FlowDocumentScrollViewer.Style>
                        </FlowDocumentScrollViewer>

                        <!-- User / thinking: selectable literal text with colour emoji (a read-only
                             RichTextBox inside; native Ctrl+C and right-click Copy keep working via
                             the control's Copy plumbing). Replaces the old read-only TextBox, whose
                             classic text stack rendered emoji as monochrome outlines. -->
                        <!-- FontSize 13 matches the assistant markdown FlowDocument (MarkdownFlowRenderer,
                             which sets FontSize=13) so user and assistant text render at the same size. -->
                        <!-- Text is set by the trigger below, NOT bound here, and that is a measured fix
                             rather than a tidy-up (issue #86). Bound unconditionally it was also set on
                             every ASSISTANT message — where this control is Collapsed and never seen —
                             and Visibility stops layout, not a property-changed callback: Rebuild() ran,
                             splitting the whole message into inlines TWICE (the measurer and the
                             paragraph) and assigning a fresh FlowDocument to the RichTextBox, on every
                             realisation of every reply. The assistant half of this Grid has always been
                             conditional; this is the same rule applied to the other half. -->
                        <controls:SelectableEmojiText FontSize="13"
                                                      PreviewMouseWheel="ForwardWheelToTranscript">
                            <!-- Same smart-Copy menu as the assistant viewer: copies the selection when
                                 present (routed through the control's emoji-aware ChatClipboard copy),
                                 else the whole block — no selection needed. -->
                            <controls:SelectableEmojiText.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Click="CopyBlock_Click" />
                                </ContextMenu>
                            </controls:SelectableEmojiText.ContextMenu>
                            <controls:SelectableEmojiText.Style>
                                <Style TargetType="controls:SelectableEmojiText">
                                    <Setter Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                    <Style.Triggers>
                                        <!-- Only a message this control actually shows gets its text built. -->
                                        <DataTrigger Binding="{Binding IsAssistant}" Value="False">
                                            <Setter Property="Text" Value="{Binding Text, Mode=OneWay}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Chat.SubtleForeground}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:SelectableEmojiText.Style>
                        </controls:SelectableEmojiText>
                    </Grid>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Tool call step: compact header; detail is collapsed (chevron toggles it) for vertical economy. -->
            <DataTemplate DataType="{x:Type vm:ToolItemViewModel}">
                <Border Margin="6,3" Padding="8,5" CornerRadius="6" Style="{StaticResource Chat.RowBorder}">
                    <Border.ContextMenu>
                        <!-- "Open file" / "Copy path" appear only on rows that acted on one — a read
                             with targets, or a call with an agent edit folded in. Without them a folded
                             edit could be diffed and never opened, while the equivalent edit CARD had
                             both all along; which of the two a backend produces is decided in AcpMapper
                             by whether its opening frame already carried a diff, so the affordances
                             have to match or the same act behaves differently per backend. -->
                        <ContextMenu>
                            <!-- The second entry point, and for two whole cases the ONLY one (issue #148):
                                 the overflow control needs the row EXPANDED and something hidden, so a
                                 collapsed row offers nothing until it is opened, and a fan-out of six or
                                 fewer never engages the cap so nothing is ever hidden. Without this,
                                 whether a sub-agent's work could be opened would depend on how big the
                                 fan-out happened to be, for no reason the user can see.

                                 FIRST, because on a sub-agent launch row the two file items are hidden
                                 anyway - a Task row acted on no file - so this gives that menu its first
                                 real action rather than sitting under two blanks.

                                 A Click, not a Command, unlike its three siblings: navigation has to
                                 capture the outgoing scroll position before the ItemsSource swaps, so
                                 every entry point routes through the view's funnel. See
                                 ChatView.OpenTranscript_Click.

                                 Visibility, not IsEnabled - matching Open file / Copy path below, where
                                 a greyed item on a row that has no calls reads as a bug on a build. -->
                            <MenuItem Header="Open transcript" Click="OpenTranscript_Click"
                                      Visibility="{Binding PlacementTarget.DataContext.CanOpenTranscript,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu},
                                      Converter={StaticResource BoolToVisible}}" />
                            <MenuItem Header="Open file" Command="{Binding PlacementTarget.DataContext.OpenFileCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Visibility="{Binding PlacementTarget.DataContext.CanOpenFile,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu},
                                      Converter={StaticResource BoolToVisible}}" />
                            <MenuItem Header="Copy path" Command="{Binding PlacementTarget.DataContext.CopyPathCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Visibility="{Binding PlacementTarget.DataContext.HasPathToCopy,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu},
                                      Converter={StaticResource BoolToVisible}}" />
                            <MenuItem Header="Copy" Command="{Binding PlacementTarget.DataContext.CopyCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <!-- DockPanel (not a horizontal StackPanel): a long title (e.g. Kiro's whole
                             command) must not push the kind label + expand toggle off the right edge, so
                             those dock right and stay visible while the title fills the middle and trims.
                             The whole row acts on click (Background=Transparent so it all hit-tests):
                             a row with an attached diff (an agent edit folded into its tool call) opens
                             the native diff viewer; otherwise it toggles expand/collapse — the chevron is
                             just the indicator, and still expands the detail even when the row click
                             opens a diff. -->
                        <DockPanel LastChildFill="True" Background="Transparent"
                                   MouseLeftButtonUp="ToolHeader_MouseLeftButtonUp">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <!-- The whole row tips its own full title, because the title is the
                                         field that TRIMS: everything else here docks right and keeps its
                                         width, so a long one is cut and the row stops saying what the
                                         call was. The title block below tips it too, but only across the
                                         text itself — a reader whose pointer is over the call count or
                                         the blank middle got nothing. Overridden below where the row
                                         click DOES something, since an action hint is worth more than
                                         re-reading a title. -->
                                    <Setter Property="ToolTip" Value="{Binding Title}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                            <Setter Property="Cursor" Value="Hand" />
                                        </DataTrigger>
                                        <!-- Later triggers win: with a file target / diff attached the row
                                             click opens it, so the tooltip advertises that instead of the
                                             expandable detail (diff last, matching the click priority). -->
                                        <DataTrigger Binding="{Binding CanOpenFile}" Value="True">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <!-- "Open file" / "Open N files" — a Kiro read batches several. -->
                                            <Setter Property="ToolTip" Value="{Binding OpenFileToolTip}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanOpenDiff}" Value="True">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ToolTip" Value="View diff" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <!-- Kind icon (read/edit/search/…); colour conveys status (running/ok/failed). -->
                            <TextBlock Text="{Binding KindGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       DockPanel.Dock="Left" Margin="0,0,7,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Chat.SubtleForeground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource Chat.SuccessForeground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                <Setter Property="Foreground" Value="{DynamicResource Chat.ErrorForeground}" />
                                            </DataTrigger>
                                            <!-- Launched: started, not finished. Deliberately not the
                                                 success colour - the work has not happened yet. -->
                                            <DataTrigger Binding="{Binding Status}" Value="Launched">
                                                <Setter Property="Foreground" Value="{DynamicResource Chat.LaunchedForeground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" DockPanel.Dock="Right"
                                          VerticalAlignment="Center" ToolTip="Show details"
                                          Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisible}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <!-- Border padding is the click target; the glyph alone is a sliver. -->
                                        <Border Background="Transparent" Padding="7,2">
                                            <TextBlock x:Name="g" Text="▸" FontSize="19"
                                                       Background="Transparent"
                                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="g" Property="Text" Value="▾" />
                                            </Trigger>
                                            <!-- Brighten on hover so it reads as an interactive control. -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Text="{Binding KindLabel, Mode=OneWay, StringFormat=' ({0})'}" DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                            <!-- The permission mark. Everything about it — the four glyphs, the two
                                 colour channels, the size and weight — is in Chat.PermissionGlyph, shared
                                 with the edit card. The expanded sentence below says the same thing in
                                 words for the finer distinctions a mark cannot carry. -->
                            <TextBlock Text="{Binding PermissionGlyph}" DockPanel.Dock="Right"
                                       Style="{StaticResource Chat.PermissionGlyph}"
                                       ToolTip="{Binding PermissionSummary}"
                                       Visibility="{Binding HasPermissionGlyph, Converter={StaticResource BoolToVisible}}" />
                            <!-- What a collapsed sub-agent row is hiding. The whole point of nesting is
                                 that a fan-out of 26 reads is ONE line, so the line has to say that it
                                 is one - otherwise the work looks like it never happened (issue #125). -->
                            <!-- Says what the colour cannot: a launched row is not a finished one. -->
                            <TextBlock Text="{Binding StatusNote}" DockPanel.Dock="Right" Margin="6,0,0,0"
                                       VerticalAlignment="Center" FontSize="11" FontStyle="Italic"
                                       ToolTip="{Binding StatusNoteToolTip}"
                                       Foreground="{DynamicResource Chat.LaunchedForeground}"
                                       Visibility="{Binding HasStatusNote, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="{Binding ChildSummary}" DockPanel.Dock="Right" Margin="6,0,0,0"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource Chat.SubtleForeground}"
                                       Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisible}}" />
                            <!-- Title, then the file the call acts on when the backend's own title didn't name it
                                 (Kiro's v3 engine titles every read "Read File" — issue #102). A Grid rather
                                 than two docked blocks so the path sits AGAINST the title and both can trim:
                                 the star column is 0 wide when there's no path, leaving the title exactly the
                                 width it has today. -->
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock md:EmojiText.PlainText="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Title}" />
                                            <Style.Triggers>
                                                <!-- With file target(s) / a diff attached the title is what the
                                                     call acts on; tip the full path(s) (same as the edit card). -->
                                                <DataTrigger Binding="{Binding HasFileTarget}" Value="True">
                                                    <Setter Property="ToolTip" Value="{Binding FileTargetToolTip}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasDiff}" Value="True">
                                                    <Setter Property="ToolTip" Value="{Binding DiffPath}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Styled exactly like the edit card's path, so a read row reads like an edit row. -->
                                <TextBlock Grid.Column="1" Text="{Binding TargetDisplayPath}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Chat.CodeFontFamily}"
                                           Foreground="{DynamicResource Chat.SubtleForeground}"
                                           ToolTip="{Binding FileTargetToolTip}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Visibility="{Binding HasTargetPath, Converter={StaticResource BoolToVisible}}" />
                            </Grid>
                        </DockPanel>
                        <!-- Intent subtitle (the agent's stated "why"): always visible, under the title. -->
                        <TextBlock md:EmojiText.PlainText="{Binding Description}" TextWrapping="Wrap" Margin="18,1,0,0"
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{DynamicResource Chat.SubtleForeground}"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisible}}" />
                        <!-- The permission sentence, FIRST in the expanded section. Present for EVERY settled
                             row, including the two that draw no glyph, so expanding a row always answers
                             "why did this run?" - which a mark alone cannot, and which is the whole question
                             this feature exists for. It leads rather than trails for two reasons: it is the
                             glyph's own expansion, so the two belong adjacent rather than separated by a
                             variable-length argument dump; and Detail below is the call's rawInput, which
                             runs to the mapper's 2000-char clamp, so a trailing sentence can sit a screen
                             down from the mark that sent the reader looking for it. -->
                        <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap" Margin="18,3,0,0"
                                   FontSize="11" Foreground="{DynamicResource Chat.SubtleForeground}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                <Condition Binding="{Binding HasPermissionSummary}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="18,3,0,0"
                                   FontFamily="{DynamicResource Chat.CodeFontFamily}" FontSize="11"
                                   Foreground="{DynamicResource Chat.SubtleForeground}"
                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}" />
                        <!-- stderr: its own section (separate stream), styled as an error. Shown only when
                             expanded AND present, so an empty error stream adds no blank line. -->
                        <StackPanel Margin="18,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                <Condition Binding="{Binding HasErrorDetail}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="stderr" FontSize="10" Margin="0,0,0,1"
                                       Foreground="{DynamicResource Chat.ErrorForeground}" Opacity="0.8" />
                            <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource Chat.CodeFontFamily}" FontSize="11"
                                       Foreground="{DynamicResource Chat.ErrorForeground}" />
                        </StackPanel>
                        <!-- The calls a sub-agent made for this row (issue #125). No ItemTemplate: the
                             children ARE ToolItemViewModels, so this template applies to them by type and
                             a sub-agent's own sub-agent nests for free.

                             Collapsed until the row is expanded, and that is load-bearing rather than
                             tidy. WPF measures nothing inside a Collapsed element, so a fan-out of 26
                             reads realises no container at all until the user asks - which is the whole
                             claim of nesting (26 lines become 1) and also the cheap shape: re-realising
                             containers is what forces WPF to regenerate render data, the dominant
                             UI-thread cost of a scroll (issue #86). -->
                        <!-- The overflow control: what the cap is holding back (issue #125). It OPENS
                             the calls as their own transcript rather than widening the row (issue #148).
                             Dropping the cap in place put the whole fan-out back inside this one
                             non-virtualizing container - the exact cost the cap exists to bound,
                             reinstated on demand - so the unbounded inline case now stops existing
                             instead of being deferred behind a click. Drilled in, the same calls are
                             drawn by the transcript's virtualising panel and cost what any row costs.

                             ABOVE the children, because the cap keeps the LAST few: what it hides is
                             what came before them, so the control sits where the hidden calls would be.

                             Sibling to the header DockPanel, not inside it, so its click cannot bubble
                             into the row's own expand toggle. -->
                        <Button Content="{Binding OpenAllChildrenLabel}" Click="OpenAllChildren_Click"
                                FontSize="11" HorizontalAlignment="Left" Margin="14,3,0,2" Padding="8,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Chat.SubtleButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                <Condition Binding="{Binding HasHiddenChildren}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ItemsControl ItemsSource="{Binding VisibleChildren}" Margin="14,3,0,0"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Edit routed through the host: styled like a tool row (pencil kind icon + card), and the
                 whole row clicks through to the native diff — matching the tool rows' click-to-act feel
                 rather than reading as a hyperlink. Path shown relative to the workspace root (DisplayPath);
                 the full path is the tooltip. No diff viewer (e.g. Desktop) → not clickable, just the row. -->
            <DataTemplate DataType="{x:Type vm:EditItemViewModel}">
                <Border Margin="6,3" Padding="8,5" CornerRadius="6" Style="{StaticResource Chat.RowBorder}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open file" Command="{Binding PlacementTarget.DataContext.OpenFileCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Copy path" Command="{Binding PlacementTarget.DataContext.CopyCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <DockPanel LastChildFill="True" Background="Transparent" ToolTip="{Binding Path}"
                                   MouseLeftButtonUp="EditRow_MouseLeftButtonUp">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanOpenDiff}" Value="True">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ToolTip" Value="View diff" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <!-- Pencil kind icon (same treatment as the tool rows' KindGlyph):
                                 colour conveys the edit call's outcome (running/ok/failed). -->
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       DockPanel.Dock="Left" Margin="0,0,7,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Chat.SubtleForeground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource Chat.SuccessForeground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                <Setter Property="Foreground" Value="{DynamicResource Chat.ErrorForeground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- The detail chevron, identical to the tool rows'. This card used to have
                                 none, so a failed write showed a red pencil and nothing else, and the
                                 permission sentence was reachable only by hovering the glyph — which is
                                 to say, undiscoverable (issue #189). Kiro v3 renders an ordinary write
                                 as this shape, so the calls that CHANGE FILES were the ones with the
                                 least to say, on the engine where they are the common case.

                                 Docked before the row click handler's content but OUTSIDE it in intent:
                                 a ToggleButton handles its own click, so toggling the expander never
                                 reaches EditRow_MouseLeftButtonUp and never opens the diff by accident. -->
                            <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" DockPanel.Dock="Right"
                                          VerticalAlignment="Center" ToolTip="Show details"
                                          Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisible}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <!-- Border padding is the click target; the glyph alone is a sliver. -->
                                        <Border Background="Transparent" Padding="7,2">
                                            <TextBlock x:Name="g" Text="▸" FontSize="19"
                                                       Background="Transparent"
                                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="g" Property="Text" Value="▾" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Edit operation (e.g. strReplace), docked right like the tool rows' kind label. -->
                            <TextBlock Text="{Binding Operation, StringFormat=' ({0})'}" DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Chat.SubtleForeground}"
                                       Visibility="{Binding HasOperation, Converter={StaticResource BoolToVisible}}" />
                            <!-- The same permission mark the tool rows carry, same style, same position
                                 relative to the trailing label. An edit rendering as a CARD rather than a
                                 tool row is a real difference in what the agent did, but it must not be a
                                 difference in what the user is told: this shape is Kiro v3's ordinary one
                                 for a write, so without the mark here the calls that CHANGE FILES would be
                                 the ones saying nothing about permission, on the engine where they are the
                                 common case. The sentence is the tooltip AND the first line of the
                                 expander below — hover for the reader already pointing at the mark, the
                                 chevron for the one who is not, since a tooltip alone is undiscoverable
                                 and left this shape short of the rule that the sentence is available on
                                 every settled row (issue #189). Still not permanent prose on every edit;
                                 opt-in, exactly as the tool row's is. -->
                            <TextBlock Text="{Binding PermissionGlyph}" DockPanel.Dock="Right"
                                       Style="{StaticResource Chat.PermissionGlyph}"
                                       ToolTip="{Binding PermissionSummary}"
                                       Visibility="{Binding HasPermissionGlyph, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="{Binding DisplayPath}" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Chat.CodeFontFamily}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                        <!-- Intent subtitle (the agent's stated "why"), matching the tool rows. -->
                        <TextBlock Text="{Binding Intent}" TextWrapping="Wrap" Margin="20,1,0,0"
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{DynamicResource Chat.SubtleForeground}"
                                   Visibility="{Binding HasIntent, Converter={StaticResource BoolToVisible}}" />
                        <!-- The expanded section, same three parts and same order as the tool row's:
                             the permission sentence FIRST (it is the glyph's own expansion, so the two
                             belong adjacent), then the result, then stderr as its own error-styled
                             section. The rule this restores is that both edit shapes must offer the
                             SAME ACTIONS — the folded tool row has had all three since #46. -->
                        <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap" Margin="20,3,0,0"
                                   FontSize="11" Foreground="{DynamicResource Chat.SubtleForeground}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                <Condition Binding="{Binding HasPermissionSummary}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="20,3,0,0"
                                   FontFamily="{DynamicResource Chat.CodeFontFamily}" FontSize="11"
                                   Foreground="{DynamicResource Chat.SubtleForeground}"
                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}" />
                        <StackPanel Margin="20,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                <Condition Binding="{Binding HasErrorDetail}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="error" FontSize="10" Margin="0,0,0,1"
                                       Foreground="{DynamicResource Chat.ErrorForeground}" Opacity="0.8" />
                            <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource Chat.CodeFontFamily}" FontSize="11"
                                       Foreground="{DynamicResource Chat.ErrorForeground}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Test-results card: pass/fail summary + the failing tests, each clickable to jump to its
                 source (when a diff/editor host + a stack-trace location are present). Rendered in addition
                 to the run_tests tool row, from the tool's structured result. -->
            <!-- Breakpoints the agent placed, listed, or removed (issue #73). Deliberately the same card
                 shape as the test results: a summary that always shows, and a chevron over the detail.
                 The rows carry what the GUTTER cannot — the condition and the agent's reason — which is
                 the whole argument for showing this in the transcript rather than letting red dots the
                 user did not place appear in their editor unexplained. -->
            <DataTemplate DataType="{x:Type vm:BreakpointCardItemViewModel}">
                <Border Margin="6,3" Padding="8,6" CornerRadius="6"
                        Background="{DynamicResource Chat.ToolBackground}"
                        BorderBrush="{DynamicResource Chat.Border}" BorderThickness="1">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="{Binding PlacementTarget.DataContext.CopyCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" DockPanel.Dock="Right"
                                          VerticalAlignment="Center" ToolTip="{Binding ExpandToolTip}"
                                          Visibility="{Binding HasRows, Converter={StaticResource BoolToVisible}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="7,2">
                                            <TextBlock x:Name="g" Text="▸" FontSize="19"
                                                       Background="Transparent"
                                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="g" Property="Text" Value="▾" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse StrokeThickness="1.2">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Stroke" Value="{DynamicResource Chat.SuccessForeground}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource Chat.ErrorForeground}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Chat.SuccessForeground}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Chat.ErrorForeground}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock md:EmojiText.PlainText="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Rows}" Margin="4,4,0,0"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BreakpointRowViewModel}">
                                    <StackPanel Margin="0,3,0,0">
                                        <!-- The whole line is the click target, as on the test card: a
                                             borderless Button whose template is just its content. -->
                                        <Button Command="{Binding OpenCommand}" Cursor="Hand"
                                                HorizontalContentAlignment="Stretch"
                                                ToolTip="Open this line in the editor">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Button.Template>
                                            <DockPanel LastChildFill="True">
                                                <!-- Tracepoint marker, docked first so it cannot be pushed
                                                     off by a long path: a tracepoint does not STOP, and a
                                                     user expecting a stop that never comes has no way to
                                                     tell why from the gutter. -->
                                                <TextBlock DockPanel.Dock="Left" Text="⇢" Margin="0,0,5,0"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource Chat.SubtleForeground}"
                                                           ToolTip="Tracepoint: prints and continues, does not stop"
                                                           Visibility="{Binding IsTracepoint, Converter={StaticResource BoolToVisible}}" />
                                                <TextBlock Text="{Binding LocationLabel}" FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Chat.Foreground}" />
                                            </DockPanel>
                                        </Button>
                                        <!-- The condition: the agent's actual contribution over a plain stop. -->
                                        <TextBlock Text="{Binding Condition}" FontFamily="Consolas" FontSize="11"
                                                   Margin="14,1,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Chat.SubtleForeground}"
                                                   Visibility="{Binding HasCondition, Converter={StaticResource BoolToVisible}}" />
                                        <TextBlock md:EmojiText.PlainText="{Binding PrintMessage}" FontFamily="Consolas" FontSize="11"
                                                   Margin="14,1,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Chat.SubtleForeground}"
                                                   Visibility="{Binding IsTracepoint, Converter={StaticResource BoolToVisible}}" />
                                        <!-- Why the agent chose this line. The one thing the gutter can
                                             never say, so it is not optional decoration. -->
                                        <TextBlock md:EmojiText.PlainText="{Binding Reason}" FontSize="11" FontStyle="Italic"
                                                   Margin="14,1,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Chat.SubtleForeground}"
                                                   Visibility="{Binding HasReason, Converter={StaticResource BoolToVisible}}" />
                                        <TextBlock md:EmojiText.PlainText="{Binding Error}" FontSize="11"
                                                   Margin="14,1,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Chat.ErrorForeground}"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The tool's own advice. Shown even when the rows are collapsed: "you set none
                             here, but N remain from earlier conversations" is the difference between the
                             user's gutter being clean and them believing it is. -->
                        <ItemsControl ItemsSource="{Binding Notes}" Margin="4,4,0,0"
                                      Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock md:EmojiText.PlainText="{Binding}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Chat.SubtleForeground}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TestRunResultItemViewModel}">
                <Border Margin="6,3" Padding="8,6" CornerRadius="6"
                        Background="{DynamicResource Chat.ToolBackground}"
                        BorderBrush="{DynamicResource Chat.Border}" BorderThickness="1">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="{Binding PlacementTarget.DataContext.CopyCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <!-- Header: composed status badge (a thin themed circle + a check/X mark) + count
                             summary, with the failure-list chevron docked right. We draw the ring
                             ourselves — the font's own outline circle-X glyphs render no visible ring at
                             this size, and the filled ones read too vibrant. -->
                        <DockPanel LastChildFill="False">
                            <!-- Chevron: same control as the tool rows, so expansion reads the same
                                 everywhere. Only offered when there are failures to show. -->
                            <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" DockPanel.Dock="Right"
                                          VerticalAlignment="Center" ToolTip="{Binding ExpandToolTip}"
                                          Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisible}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <!-- Border padding is the click target; the glyph alone is a sliver. -->
                                        <Border Background="Transparent" Padding="7,2">
                                            <TextBlock x:Name="g" Text="▸" FontSize="19"
                                                       Background="Transparent"
                                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="g" Property="Text" Value="▾" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse StrokeThickness="1.2">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Stroke" Value="{DynamicResource Chat.SuccessForeground}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource Chat.ErrorForeground}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Chat.SuccessForeground}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Chat.ErrorForeground}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock md:EmojiText.PlainText="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Failing tests: each row clicks through to its source location. Collapsed
                             behind the chevron once there are more than a handful (a broken suite would
                             otherwise bury the transcript). -->
                        <ItemsControl ItemsSource="{Binding Failures}" Margin="4,4,0,0"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TestFailureViewModel}">
                                    <StackPanel Margin="0,3,0,0">
                                        <!-- Right-click offers BOTH ends of the trace. Clicking the row goes
                                             to the test (VS's Test Explorer convention: double-click opens
                                             the test, the stack-trace links reach the assertion), so the
                                             test jump is listed first as the default action; the throw site
                                             is the second item. Collapsed outright when neither is available,
                                             so a host with no editor can't pop an empty menu. -->
                                        <StackPanel.ContextMenu>
                                            <!-- A ContextMenu is its own visual tree, so bind the row's
                                                 view-model through PlacementTarget rather than relying on
                                                 inheritance (the card's Copy menu does the same). -->
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                                       RelativeSource={RelativeSource Self}}"
                                                         Visibility="{Binding HasContextActions, Converter={StaticResource BoolToVisible}}">
                                                <MenuItem Header="{Binding OpenTestHeader}" Command="{Binding OpenTestCommand}"
                                                          FontWeight="SemiBold"
                                                          InputGestureText="{Binding TestLocationLabel}"
                                                          Visibility="{Binding CanOpenTest, Converter={StaticResource BoolToVisible}}" />
                                                <MenuItem Header="Go to failure" Command="{Binding OpenFailureCommand}"
                                                          InputGestureText="{Binding LocationLabel}"
                                                          Visibility="{Binding CanOpenFailure, Converter={StaticResource BoolToVisible}}" />
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <!-- Borderless button so the whole name+location line is the click
                                             target; disabled (no-op) when there's no location to open. -->
                                        <Button Command="{Binding OpenCommand}" Cursor="Hand"
                                                ToolTip="{Binding LocationToolTip}"
                                                HorizontalContentAlignment="Left" Padding="0" BorderThickness="0"
                                                Background="Transparent">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Button.Template>
                                            <!-- DockPanel: the location stays pinned right (always visible)
                                                 while a long test name fills the middle and trims. -->
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Chat.ErrorForeground}" />
                                                <!-- Shows where the CLICK lands (the test when we have one),
                                                     not necessarily the throw site; the tooltip carries both. -->
                                                <TextBlock Text="{Binding PrimaryLocationLabel}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" FontSize="11"
                                                           FontFamily="{DynamicResource Chat.CodeFontFamily}"
                                                           Foreground="{DynamicResource Chat.SubtleForeground}"
                                                           Visibility="{Binding HasPrimaryLocation, Converter={StaticResource BoolToVisible}}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           Foreground="{DynamicResource Chat.Foreground}" />
                                            </DockPanel>
                                        </Button>
                                        <!-- Failure message, muted + wrapped, under the name. -->
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="18,1,0,0"
                                                   FontFamily="{DynamicResource Chat.CodeFontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource Chat.SubtleForeground}"
                                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Shown when the failing-test list was capped by the tool (and is on screen). -->
                        <TextBlock Text="…more failures not shown" Margin="4,4,0,0" FontSize="11" FontStyle="Italic"
                                   Foreground="{DynamicResource Chat.SubtleForeground}"
                                   Visibility="{Binding ShowTruncatedNote, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Plan / task list: one card that updates in place as the agent ticks items off. -->
            <DataTemplate DataType="{x:Type vm:PlanItemViewModel}">
                <Border Margin="6,4" Padding="9,7" CornerRadius="6"
                        Background="{DynamicResource Chat.ToolBackground}"
                        BorderBrush="{DynamicResource Chat.Border}" BorderThickness="1">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="{Binding PlacementTarget.DataContext.CopyCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <TextBlock md:EmojiText.PlainText="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"
                                   Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisible}}" />
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Margin="0,0,7,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Chat.SubtleForeground}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InProgress}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Chat.AccentBackground}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Completed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Chat.SuccessForeground}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock md:EmojiText.PlainText="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InProgress}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Completed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Chat.SubtleForeground}" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Sub-agent crew: one live card per parallel crew (e.g. Kiro sub-agents), a row per
                 sub-agent with live status. A finished row's chevron expands the final result the
                 sub-agent returned to the orchestrator, rendered as markdown — built lazily
                 (VisibleResult is empty until expanded), since results can be whole files. The
                 sub-agents' raw activity streams are filtered out upstream and never shown. -->
            <DataTemplate DataType="{x:Type vm:CrewItemViewModel}">
                <Border Margin="6,4" Padding="9,7" CornerRadius="6"
                        Background="{DynamicResource Chat.ToolBackground}"
                        BorderBrush="{DynamicResource Chat.Border}" BorderThickness="1">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="{Binding PlacementTarget.DataContext.CopyCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <!-- Header: crew (people) glyph + the crew's group label. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5"
                                    Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Margin="0,0,7,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                            <TextBlock md:EmojiText.PlainText="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CrewAgentViewModel}">
                                    <StackPanel Margin="0,1">
                                        <DockPanel LastChildFill="True">
                                            <!-- Status mark: … while working, ✓ once terminated. -->
                                            <TextBlock Text="{Binding StatusGlyph}" FontSize="13" Width="14"
                                                       DockPanel.Dock="Left" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Chat.SuccessForeground}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Chat.AccentBackground}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Chevron: expands the final result (only once one arrived). -->
                                            <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" DockPanel.Dock="Right"
                                                          VerticalAlignment="Center" ToolTip="Show result"
                                                          Visibility="{Binding HasResult, Converter={StaticResource BoolToVisible}}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" Padding="7,2">
                                                            <TextBlock x:Name="g" Text="▸" FontSize="19"
                                                                       Background="Transparent"
                                                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="g" Property="Text" Value="▾" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <TextBlock Text="{Binding StatusLabel}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                                            <!-- The sub-agent's name; its task (initial query) as the tooltip. -->
                                            <TextBlock md:EmojiText.PlainText="{Binding Name}" VerticalAlignment="Center"
                                                       ToolTip="{Binding Description}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DockPanel>
                                        <!-- The final result, rendered as markdown when expanded. -->
                                        <Border Margin="21,3,0,3" Padding="6,4" CornerRadius="4"
                                                BorderBrush="{DynamicResource Chat.Border}" BorderThickness="1"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                                            <FlowDocumentScrollViewer md:MarkdownText.Text="{Binding VisibleResult}"
                                                                      md:MarkdownText.Links="{Binding DataContext.FileLinks,
                                                                          RelativeSource={RelativeSource AncestorType=views:ChatView}}"
                                                                      Style="{StaticResource Chat.MarkdownDocument}"
                                                                      PreviewMouseWheel="ForwardWheelToTranscript" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Notice / status line. A notice carrying diagnostic detail (a backend failure) grows a
                 chevron; everything else renders exactly as it always did. -->
            <DataTemplate DataType="{x:Type vm:NoticeItemViewModel}">
                <StackPanel Margin="0,3">
                    <DockPanel LastChildFill="True">
                        <!-- Chevron: the same control as the tool rows, so expansion reads the same
                             everywhere. Only present when there is detail behind it. -->
                        <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" DockPanel.Dock="Right"
                                      VerticalAlignment="Top" ToolTip="{Binding ExpandToolTip}"
                                      Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisible}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!-- Border padding is the click target; the glyph alone is a sliver. -->
                                    <Border Background="Transparent" Padding="7,0">
                                        <TextBlock x:Name="g" Text="▸" FontSize="19"
                                                   Background="Transparent"
                                                   Foreground="{DynamicResource Chat.SubtleForeground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="g" Property="Text" Value="▾" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock md:EmojiText.PlainText="{Binding Text}" Margin="10,0" TextWrapping="Wrap" FontStyle="Italic">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Command="{Binding PlacementTarget.DataContext.CopyCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Chat.SubtleForeground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Chat.ErrorForeground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>

                    <!-- The detail panel. A read-only TextBox rather than a TextBlock so the text is
                         SELECTABLE: this exists to be pasted into a bug report, and "I can't copy the
                         error off the broken machine" has already cost one diagnosis round-trip here.
                         Monospace and NOT markdown-rendered — see NoticeItemViewModel.Details. -->
                    <Border Margin="10,4,10,2" Padding="6,4" CornerRadius="4"
                            BorderBrush="{DynamicResource Chat.Border}" BorderThickness="1"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                        <TextBox Text="{Binding Details, Mode=OneWay}"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" MaxHeight="320"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{DynamicResource Chat.CodeFontFamily}"
                                 Foreground="{DynamicResource Chat.SubtleForeground}"
                                 PreviewMouseWheel="ForwardWheelToTranscript" />
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: provider + model + permission pickers, streaming dots, new-session, scope notice -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Chat.Border}" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ProviderPicker" Grid.Column="0" MinWidth="96" Margin="0,0,4,0"
                              ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding CanChangeSelection}"
                              ToolTip="Backend" />

                    <ComboBox Grid.Column="1" MinWidth="96"
                              ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                              IsEnabled="{Binding CanChangeSelection}"
                              ToolTip="Model">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModelItemViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <!-- Relative cost, muted, after the name (empty for "Kiro default"). -->
                                    <TextBlock Text="{Binding RateLabel}" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Chat.SubtleForeground}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- The permission picker used to sit here; it now lives in the status strip at the
                         bottom of the pane, next to where its banner appears. -->

                    <!-- History: opens the saved-conversation picker (only when a store is wired). -->
                    <ToggleButton Grid.Column="2" x:Name="HistoryButton" Margin="4,0,0,0" Cursor="Hand"
                                  IsChecked="{Binding IsHistoryOpen, Mode=TwoWay}"
                                  Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisible}}"
                                  ToolTip="Saved conversations">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="5,3">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource Chat.Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup Grid.Column="2" x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=HistoryButton}" Placement="Bottom"
                           AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                           IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}" MinWidth="280" MaxWidth="360">
                        <Border Background="{DynamicResource Chat.Background}" BorderBrush="{DynamicResource Chat.Border}"
                                BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,2,8,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4" />
                            </Border.Effect>
                            <DockPanel MaxHeight="380">
                                <TextBlock DockPanel.Dock="Top" Text="Conversations" FontWeight="SemiBold"
                                           Margin="6,4,6,6" Foreground="{DynamicResource Chat.Foreground}" />

                                <!-- The two lists are TABBED rather than stacked. They used to share one
                                     scrolling surface with the backend's below the saved ones, which is
                                     fine on a fresh workspace and useless on a worked-in one: the saved
                                     list is unbounded, so the second section was reached only by
                                     scrolling past every conversation the workspace had. The lists are
                                     also answered by different things - a directory read against a CLI
                                     spawn - so one of them is always the one that has arrived.

                                     The strip appears only when there IS a second tab (HasCliSection),
                                     and that is the same rule the section itself followed rather than a
                                     new one: a backend that has never offered session listing gets no
                                     standing explanation, and a permanently greyed pill is a standing
                                     explanation with a click on it. Bound to HasCliSection directly, not
                                     to an alias - one truth for "is there a second thing to look at".

                                     ChatViewModel.HistoryTab coerces back to Saved whenever this goes
                                     false, so the strip disappearing can never leave the picker showing
                                     a pane that no longer exists. -->
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,6"
                                            Visibility="{Binding HasCliSection, Converter={StaticResource BoolToVisible}}">
                                    <ToggleButton x:Name="SavedSessionsTab" Style="{StaticResource Chat.TabPill}" Content="Saved"
                                                  Command="{Binding ShowSavedTabCommand}"
                                                  IsChecked="{Binding ShowSavedSessions, Mode=OneWay}"
                                                  ToolTip="Conversations saved here for this folder." />
                                    <!-- "Agent's history", NOT "From the CLI". The wording is the
                                         section header's, shortened to fit a pill and no further: origin
                                         is unrecorded, so the label may say whose STORE holds it and
                                         never which program put it there (the header's own comment,
                                         below, carries the measurement). -->
                                    <ToggleButton x:Name="BackendSessionsTab" Style="{StaticResource Chat.TabPill}" Margin="2,0,0,0"
                                                  Command="{Binding ShowBackendTabCommand}"
                                                  IsChecked="{Binding ShowBackendSessions, Mode=OneWay}"
                                                  ToolTip="Conversations the agent's own store holds for this folder.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Agent's history" />
                                            <!-- A count once rows are in, an ellipsis while a CLI is
                                                 still being spawned, nothing when the answer was none -
                                                 so "still looking" never reads as "nothing here". -->
                                            <TextBlock Text="{Binding BackendTabBadge}" Margin="4,0,0,0" Opacity="0.75"
                                                       Visibility="{Binding HasBackendTabBadge, Converter={StaticResource BoolToVisible}}" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>

                                <!-- One pane drawn at a time, each with its OWN ScrollViewer. Sharing one
                                     would carry an offset from the list left behind into the list
                                     arrived at, which on a short list is a blank pane. -->
                                <Grid>
                                <!-- A DockPanel, not a ScrollViewer over a StackPanel: the list owns its
                                     own scrolling so that it HAS a viewport to virtualize against. See
                                     Chat.SessionList. -->
                                <DockPanel x:Name="SavedSessionsPane"
                                           Visibility="{Binding ShowSavedSessions, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock DockPanel.Dock="Top" Text="No saved conversations yet." Margin="6,2,6,6"
                                               FontSize="11" Foreground="{DynamicResource Chat.SubtleForeground}"
                                               Visibility="{Binding HistoryEmpty, Converter={StaticResource BoolToVisible}}" />
                                    <ItemsControl ItemsSource="{Binding History}" Style="{StaticResource Chat.SessionList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SessionSummaryViewModel}">
                                                <!-- The whole row opens the conversation on click; the inner rename/delete
                                                     buttons handle their own clicks (so they don't also open it). -->
                                                <Button Command="{Binding LoadCommand}" Margin="0,1" Cursor="Hand"
                                                        HorizontalContentAlignment="Stretch" ToolTip="Open this conversation">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="6,4">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <!-- Title: a plain label, swapped for an edit box only while renaming. -->
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Chat.Foreground}"
                                                                       Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisible}}" />
                                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                                                     Background="{DynamicResource Chat.InputBackground}" BorderThickness="0" Padding="2,0"
                                                                     Foreground="{DynamicResource Chat.Foreground}" CaretBrush="{DynamicResource Chat.Foreground}"
                                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}"
                                                                     IsVisibleChanged="SessionTitleBox_IsVisibleChanged"
                                                                     LostFocus="SessionTitleBox_LostFocus"
                                                                     PreviewKeyDown="SessionTitleBox_PreviewKeyDown" />
                                                            <!-- Agent chip: the backend(s) this conversation ran on ("Kiro → Claude Code"
                                                                 when a summary-resume switched agents). Hidden for pre-tracking sessions. -->
                                                            <Border Margin="2,2,0,0" Padding="4,0" CornerRadius="3" HorizontalAlignment="Left"
                                                                    Background="{DynamicResource Chat.HoverBackground}"
                                                                    Visibility="{Binding HasAgentLabel, Converter={StaticResource BoolToVisible}}">
                                                                <TextBlock Text="{Binding AgentLabel}" FontSize="10"
                                                                           Foreground="{DynamicResource Chat.SubtleForeground}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Subtitle}" Margin="2,2,0,0" FontSize="10"
                                                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Command="{Binding RenameCommand}" Margin="4,0,0,0"
                                                                Style="{StaticResource Chat.IconButton}" Width="26" ToolTip="Rename">
                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                                                        </Button>
                                                        <Button Grid.Column="2" Command="{Binding DeleteCommand}" Margin="4,0,0,0"
                                                                Style="{StaticResource Chat.IconButton}" Width="26" ToolTip="Delete">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                                                        </Button>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>

                                <!-- Conversations the backend's own store holds that we do not,
                                     offered so they can be picked up here (issue #108). Its own tab
                                     rather than merged into the saved list, because a click here does
                                     something materially heavier - it opens a backend session and loads
                                     the whole conversation - and because the two are answered by
                                     different things: the saved list is a directory read, this is a CLI
                                     spawn. It sat BELOW the saved list under one ScrollViewer until
                                     2026-09-02; that kept the popup a single scrolling surface, at the
                                     price of putting this section past every saved conversation the
                                     workspace had.

                                     IT SAYS WHERE WE DID NOT GET IT FROM, NOT WHERE IT CAME FROM,
                                     and that is the whole point of the wording. It read "From the
                                     CLI" until 2026-08-26, which asserts a provenance NOTHING
                                     carries. Kiro v3 is one backend behind two surfaces - the IDE
                                     bundles @kiro/agent, kiro-cli downloads the same package - and
                                     they share a store, so a session created by hand in the Kiro
                                     IDE was offered here under "From the CLI" with a "Kiro CLI"
                                     chip, having never been near a terminal. Origin is not merely
                                     unread but UNRECORDED: checked every bucket's session.json and
                                     there is no client/source/origin key of any kind, and the row's
                                     _meta.kiro.source is "local"/"remote" - the execution target,
                                     not the application.

                                     The trap is why it shipped looking right. On Kiro's DEFAULT
                                     engine the label was true by accident of a store split, not by
                                     derivation: sessions/cli/ is a flat store the IDE cannot write
                                     to, so everything in it really had come from the CLI. Nothing
                                     checked that - the store enforced it - and switching engine
                                     removes the accident, at which point the same string starts
                                     asserting something false with no code change and nothing
                                     failing. Same shape as the <workspace-context> title: a display
                                     string right for a reason nobody had written down.

                                     And it was never Kiro-only. OUR OWN DEDUPE IS THE PROOF: every
                                     session this extension creates lands in that same store, which
                                     is the entire reason DedupeAgainstSavedSessions exists. A store
                                     we ourselves write to was never "the CLI's" on any backend. -->
                                <DockPanel x:Name="BackendSessionsPane"
                                           Visibility="{Binding ShowBackendSessions, Converter={StaticResource BoolToVisible}}">
                                    <!-- No heading inside the pane: the pill that got you here is the
                                         heading, and a second copy of it would be the only thing at the
                                         top of a list the user just asked for by name. -->

                                    <!-- Carries all three empty states - still looking, nothing found,
                                         cannot be asked - because they are different answers and the
                                         backend's own words for the last one are more use than ours. -->
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding BackendSessionsMessage}" Margin="6,2,6,6"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Chat.SubtleForeground}"
                                               Visibility="{Binding HasBackendSessionsMessage, Converter={StaticResource BoolToVisible}}" />

                                    <!-- Docked children come FIRST and the list LAST: a DockPanel gives its
                                         final child the remaining space and ignores that child's Dock, so a
                                         trailing Dock="Bottom" button would fill the pane and push the list
                                         into a Left dock instead. -->
                                    <!-- Conversations created and never used, held back rather than
                                         dropped (Core.BackendSessionFilter). Nearly all of them are
                                         OURS: the warm start opens a session on every chat-window
                                         open, and a window nobody prompts leaves one in the backend's
                                         store that no dedupe can reach, because nothing was saved here
                                         to dedupe it against. Measured on this repo 2026-09-03, Kiro
                                         v3: 9 of 31 rows.

                                         THE COUNT AND THE WAY BACK ARE THE PRICE OF FILTERING AT ALL.
                                         Neither backend reports a message count, so the rule rests on
                                         two weak signals agreeing, and a heuristic that can silently
                                         show fewer conversations than exist is the one thing this
                                         picker must not do. Stated as a number rather than "some were
                                         hidden", which cannot be acted on. -->
                                    <!-- Docked BOTTOM, not left at the end of the list. The list now scrolls
                                         itself, so a trailing element would sit past the last row where the
                                         count is exactly what a user hunting a missing conversation cannot
                                         find. Pinned, it is the one thing in this pane that is always read. -->
                                    <Button DockPanel.Dock="Bottom" x:Name="ShowUnusedSessions" Command="{Binding ShowUnusedBackendSessionsCommand}"
                                            HorizontalAlignment="Left" Margin="6,4,6,4" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            ToolTip="Conversations the backend created and nothing was ever said in — usually a chat window that was opened and not used."
                                            Visibility="{Binding HasUnusedBackendSessions, Converter={StaticResource BoolToVisible}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock x:Name="Label" Text="{Binding UnusedBackendSessionsLabel}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Chat.SubtleForeground}" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Label" Property="Foreground"
                                                                Value="{DynamicResource Chat.LinkForeground}" />
                                                        <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding BackendSessions}" Style="{StaticResource Chat.SessionList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BackendSessionItemViewModel}">
                                                <Button Command="{Binding ImportCommand}" Cursor="Hand"
                                                        HorizontalContentAlignment="Stretch" Padding="6,4"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTip="Open this conversation here. The agent keeps its context, so you can carry on.">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Row" Background="{TemplateBinding Background}"
                                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background"
                                                                            Value="{DynamicResource Chat.HoverBackground}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Chat.Foreground}" />
                                                        <!-- Exactly the chip a saved row carries, and
                                                             deliberately identical: the section spans
                                                             backends so the header cannot name one, and
                                                             anything appended to distinguish it from a
                                                             saved row would be a claim about where the
                                                             conversation came from. The SECTION is what
                                                             tells them apart. -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Margin="0,2,0,0" Padding="4,0" CornerRadius="3"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{DynamicResource Chat.HoverBackground}">
                                                                <TextBlock Text="{Binding AgentLabel}" FontSize="10"
                                                                           Foreground="{DynamicResource Chat.SubtleForeground}" />
                                                            </Border>
                                                            <!-- The date's tooltip says what the date IS: the
                                                                 backends report a file mtime under a field the
                                                                 protocol calls "last activity", so it can be a day
                                                                 out. Null when no date was reported, which lets the
                                                                 button's own tooltip show through instead of
                                                                 explaining a number that is not on screen. -->
                                                            <TextBlock Text="{Binding Subtitle}" Margin="4,2,0,0" FontSize="10"
                                                                       ToolTip="{Binding TimeTooltip}"
                                                                       Foreground="{DynamicResource Chat.SubtleForeground}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Popup>

                    <!-- Whole-conversation actions: left-click opens the same menu as right-click
                         (the ContextMenu is the single definition). Trails at the far right so History +
                         New (session management) stay paired.

                         SHARE (E72D), not Copy (E8C8) and not More (E712). All three items take the
                         conversation ELSEWHERE - to the clipboard, to a file, to another program - and
                         that common thread is real, so the glyph can name it. An export glyph cannot:
                         "continue in a terminal" is a hand-off, not an export.

                         More was the first answer here and it optimised for the wrong thing. It is
                         future-proof - it survives any item added later, of any kind - but it SAYS
                         NOTHING, and the problem this button actually has is discoverability: the
                         terminal hand-off is buried in a menu on an icon button with no other cue, and
                         "..." is the least informative glyph available. Trading the one real problem
                         for a hypothetical one was the wrong trade.

                         The objection to an outbound glyph is that clicking opens a MENU rather than
                         performing an action - but the share sheet is exactly this pattern and is
                         universally understood: an outbound icon opening a list of destinations.

                         TRIGGER TO CHANGE IT BACK: an item that is not outbound. Then the common thread
                         is gone, More is right again, and it is a one-character change - this glyph has
                         now moved twice for exactly that reason, cheaply both times.

                         E72D is in the Private Use Area of Segoe MDL2 Assets, so it carries no emoji
                         presentation and cannot be re-served from a colour font - but a missing glyph
                         still renders as a box, and no assertion can tell one from a real icon, so this
                         is verified by the screenshot mode rather than by a check. Which codepoint is
                         which was settled the same way: ten candidates rendered side by side in the
                         header and read off, rather than recalled from memory. -->
                    <Button Grid.Column="4" x:Name="ExportButton" Margin="4,0,0,0" Width="26" Cursor="Hand"
                            Style="{StaticResource Chat.IconButton}" Click="ExportButton_Click"
                            ToolTip="Copy, export or continue this conversation">
                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource Chat.Foreground}" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy all as Markdown" Command="{Binding PlacementTarget.DataContext.CopyTranscriptCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Export as Markdown…" Click="ExportChat_Click" />
                                <Separator Visibility="{Binding PlacementTarget.DataContext.CanContinueInTerminal,
                                           RelativeSource={RelativeSource AncestorType=ContextMenu},
                                           Converter={StaticResource BoolToVisible}}" />
                                <!-- Hidden rather than greyed when the backend has no verified resume
                                     command or the conversation has no backend id: a disabled item on a
                                     build where it can never work reads as a bug. Same rule as "Open
                                     file" on a tool row that acted on no file. -->
                                <MenuItem Header="Continue in a terminal…"
                                          Command="{Binding PlacementTarget.DataContext.ContinueInTerminalCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Visibility="{Binding PlacementTarget.DataContext.CanContinueInTerminal,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu},
                                          Converter={StaticResource BoolToVisible}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Grid.Column="3" Command="{Binding NewSessionCommand}" Margin="4,0,0,0"
                            Style="{StaticResource Chat.SubtleButton}"
                            ToolTip="Start a new session (clears the transcript)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M7,3 H9 V7 H13 V9 H9 V13 H7 V9 H3 V7 H7 Z" Stretch="Uniform"
                                  Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center"
                                  Fill="{DynamicResource Chat.Foreground}" />
                            <TextBlock Text="New" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Working-scope notice (e.g. no project open → default workspace). -->
                <TextBlock Text="{Binding WorkspaceNotice}" Margin="0,4,0,0" TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource Chat.SubtleForeground}"
                           Visibility="{Binding WorkspaceNotice, Converter={StaticResource NullToCollapsed}}" />

                <!-- Pinned plan strip: re-surfaces the live plan while it's underway, so a long turn
                     can't scroll it out of sight (issue #17). Click scrolls the plan card back into
                     view; the strip leaves once every item ticks off. -->
                <Border x:Name="PlanBar" Margin="0,4,0,0" Padding="7,4" CornerRadius="4" Cursor="Hand"
                        Background="{DynamicResource Chat.AssistantBackground}"
                        Visibility="{Binding IsPlanBarVisible, Converter={StaticResource BoolToVisible}}"
                        MouseLeftButtonUp="PlanBar_MouseLeftButtonUp"
                        ToolTip="Show the plan">
                    <DockPanel LastChildFill="True" DataContext="{Binding ActivePlan}">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Chat.SubtleForeground}" />
                        <!-- Dismiss: hides the strip until the plan meaningfully changes (an abandoned
                             plan would otherwise pin it forever). A Button handles its own click, so it
                             doesn't also trigger the bar's scroll-to-plan. -->
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Cursor="Hand" VerticalAlignment="Center"
                                Command="{Binding DataContext.DismissPlanBarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="Hide (reappears if the plan changes)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- Border padding is the click target; the glyph alone is a sliver. -->
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="4,2">
                                        <TextBlock x:Name="g" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   Foreground="{DynamicResource Chat.SubtleForeground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                            <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Chat.Foreground}">
                            <Run Text="Plan" /><Run Text="{Binding ProgressText, Mode=OneWay, StringFormat=' {0}'}" />
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentTaskDescription}" VerticalAlignment="Center"
                                   FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Foreground="{DynamicResource Chat.SubtleForeground}" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- The transcript row. Two children: the VIRTUALISED item list, and the typing indicator
             pinned beneath it.

             VIRTUALISATION (measured, see the Desktop host's perf harness): a plain ItemsControl inside an outer
             ScrollViewer realises every item forever, and because the message box and the permission
             banner sit on Auto rows of this same Grid, either one resizing re-measures the WHOLE
             transcript. That cost is linear in history — 478ms to add a newline at 500 items on a dev
             box, 2074ms on a VDI, and 3353ms to dismiss a permission banner. Making the ItemsControl
             own its ScrollViewer (CanContentScroll=True) over a VirtualizingStackPanel bounds the
             realised set to roughly a viewport, so those gestures stop scaling with conversation length.

             The measurement also showed WHY it has to be virtualisation rather than a cheaper fix: the
             cost is not proportional to visual count. User bubbles (SelectableEmojiText) cost 0.67ms
             for 200 items while assistant messages cost 443ms for the same count, because each one
             hosts a FlowDocumentScrollViewer that reformats its document whenever the viewport height
             changes. Replacing just that host would still leave ~215ms per keystroke at 500 items on
             the VDI; bounding the realised set removes the scaling entirely.

             ScrollUnit=Pixel keeps scrolling smooth (the default Item unit jumps a whole message per
             wheel notch); Recycling reuses containers rather than rebuilding them per scroll.

             Ctrl+MouseWheel zooms; the ScaleTransform is a LayoutTransform so text re-wraps at the
             zoomed size instead of clipping. It sits on the ItemsControl, which now CONTAINS the
             scroller, so unlike before the scrollbar scales with the zoom too — the alternative
             (transforming the ItemsPresenter inside the template) leaves the panel's scroll offsets in
             unscaled units while the viewport is scaled, which breaks scrolling outright. -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Row 0 is the breadcrumb, which exists only while drilled into a sub-agent's calls
                     (issue #148) and takes no height otherwise. -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The way back. A breadcrumb rather than a single Back chip because nesting is recursive -
                 a sub-agent's own sub-agent nests for free - so at depth 2 one chip pops a frame and
                 names no path: the user can see that there is somewhere to go and not where they are.

                 OUTSIDE the ZoomTransform, like the jump-to-latest pill and for the same reason: it acts
                 on the view rather than being part of the conversation, so by the pane's rule it is
                 chrome and follows the environment font, not Ctrl+MouseWheel.

                 Its own row rather than an overlay: it must not sit on top of the first message. -->
            <Border x:Name="BreadcrumbBar" Grid.Row="0" Padding="8,3"
                    Background="{DynamicResource Chat.AssistantBackground}"
                    BorderBrush="{DynamicResource Chat.Border}" BorderThickness="0,0,0,1"
                    Visibility="{Binding IsDrilledIn, Converter={StaticResource BoolToVisible}}">
                <ItemsControl ItemsSource="{Binding Breadcrumb}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Wraps: a deep path of long tool titles must not push the last crumb -
                                 the one saying where you are - off the right edge. -->
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- The crumb you are on is drawn as text, not as a control: a button
                                     that navigates to where you already are is an affordance that does
                                     nothing, and a disabled one reads as something broken. -->
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           MaxWidth="220" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Label}"
                                           Foreground="{DynamicResource Chat.Foreground}"
                                           Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisible}}" />
                                <Button Click="Breadcrumb_Click"
                                        Style="{StaticResource Chat.SubtleButton}"
                                        Padding="4,1" MaxWidth="220"
                                        ToolTip="{Binding Label}"
                                        Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVisible}}">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </Button>
                                <!-- The root crumb's dot: the conversation gained something while the
                                     user was in here. The pane deliberately never navigates on their
                                     behalf, so the way back is where that has to be said. -->
                                <Ellipse Width="5" Height="5" Margin="3,0,0,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource Chat.LaunchedForeground}"
                                         ToolTip="The conversation has moved on while you were in here"
                                         Visibility="{Binding HasNewActivity, Converter={StaticResource BoolToVisible}}" />
                                <TextBlock Text="&#x203A;" Margin="5,0,5,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Chat.SubtleForeground}"
                                           Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVisible}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- NOTE: VerticalAlignment="Top" here does NOT make a short transcript shrink-wrap, so the
                 typing indicator below cannot be made to hug the last message that way (tried, measured,
                 reverted). With CanContentScroll=True the VirtualizingStackPanel is the IScrollInfo, and
                 it reports the VIEWPORT as its desired height rather than its content — so the scroller
                 always wants the whole row and there is nothing for the alignment to collapse. -->
            <!-- The three input handlers below are how the transcript knows a scroll is the USER's:
                 the wheel, the pointer being held (thumb drag, track click, a selection dragged past
                 the top edge) and the navigation keys. Tunnelling, so they see the gesture whatever
                 inner control it lands on, and before the scroller acts on it. Everything else that
                 moves the view — clamps, viewport changes, bring-into-view — is by construction not a
                 gesture and must not stop the follow. -->
            <!-- A TranscriptItemsControl rather than a plain ItemsControl for one reason: it times what
                 realising and laying out its rows costs, per KIND of row (issue #86's [realise] trace).
                 Nothing else changes, and with the trace off the whole of it is two static bool tests
                 per layout pass — see the class remarks for why no lighter seam exists. -->
            <controls:TranscriptItemsControl x:Name="TranscriptItems" Grid.Row="1" ItemsSource="{Binding CurrentItems}"
                          LayoutTransform="{StaticResource ZoomTransform}"
                          PreviewMouseWheel="TranscriptScroll_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="TranscriptItems_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="TranscriptItems_PreviewMouseLeftButtonUp"
                          PreviewKeyDown="TranscriptItems_PreviewKeyDown"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingStackPanel.ScrollUnit="Pixel">
                <!-- Right-clicking the transcript background (not a message/tool row, which have their own
                     menus) offers the whole-conversation actions, mirroring the header button's menu.
                     The mirror is a CLAIM this comment makes, so the terminal hand-off is here too: it
                     went in beside the other two in the header and not here, and for a while the comment
                     described a mirror that had stopped being one. Its Command binds to the same
                     property as the header's, so the header's wiring check covers this one by
                     construction - a missing target kills both. -->
                <controls:TranscriptItemsControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy all as Markdown" Command="{Binding PlacementTarget.DataContext.CopyTranscriptCommand,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Export as Markdown…" Click="ExportChat_Click" />
                        <Separator Visibility="{Binding PlacementTarget.DataContext.CanContinueInTerminal,
                                   RelativeSource={RelativeSource AncestorType=ContextMenu},
                                   Converter={StaticResource BoolToVisible}}" />
                        <MenuItem Header="Continue in a terminal…"
                                  Command="{Binding PlacementTarget.DataContext.ContinueInTerminalCommand,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.CanContinueInTerminal,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu},
                                  Converter={StaticResource BoolToVisible}}" />
                    </ContextMenu>
                </controls:TranscriptItemsControl.ContextMenu>
                <controls:TranscriptItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </controls:TranscriptItemsControl.ItemsPanel>
                <!-- The ItemsControl must own its ScrollViewer for virtualisation to engage: an outer
                     ScrollViewer measures the panel with infinite height, so every item realises. The
                     code-behind reaches this by name via the template (ChatView.TranscriptScroll).

                     A thumb drag catches two or three times on the way; that is ACCEPTED, not unexplained
                     (measured, see the Desktop host's perf harness). Realising an item costs in
                     proportion to its ELEMENT count, and a long markdown-rich reply is thousands of
                     Paragraph/List/Run elements: 10.15ms of layout per drag step against 2.73ms for the
                     same 12KB as plain prose, worst steps over 100ms. Recycling discards a container's
                     visual subtree when it scrolls out, so the cost is paid again on every re-entry —
                     which is why the pauses never wear off however many times the same stretch is
                     dragged, and why nothing that warms up can fix them.

                     Four fixes tried and rejected, so none of them is re-proposed:
                       * caching item heights — WPF already caches them in item storage with no eviction
                         and self-warms (drift 9.6% first pass, 0.8% second, zero backward steps).
                         Tracking was never the problem.
                       * caching the built FlowDocument — building is ~0.15ms of a ~1.4ms realisation;
                         the rest is WPF text formatting, which happens wherever the document is placed.
                       * trimming VirtualizingPanel.CacheLength — 0/1/2 pages measured flat.
                       * ScrollViewer.IsDeferredScrollingEnabled — the only lever that actually removes
                         the work from the gesture (thumb moves freely, content updates on release), and
                         it does. Rejected on the trade after trying it: a drag becomes a jump rather
                         than a scan, and the transcript not moving under the thumb is worse to use than
                         the pauses it removes. Re-add it as one attribute here if that judgement ever
                         changes, but note the harness CANNOT check it — it engages only for a real
                         ScrollBar thumb gesture and ScrollToVerticalOffset bypasses it, so an earlier
                         harness row measured the undeferred path twice and read as "no difference". -->
                <controls:TranscriptItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="PART_TranscriptScroll" Focusable="False"
                                      CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                      Padding="0,4">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </controls:TranscriptItemsControl.Template>
            </controls:TranscriptItemsControl>

            <!-- "Jump to latest": the standard affordance for a live conversation (Slack, Discord, Teams,
                 VS Code's chat), shown only once the transcript has stopped following the newest content.

                 It is load-bearing rather than decorative. Re-pinning deliberately requires reaching the
                 TRUE bottom (ChatView.RepinThresholdPx), because the lenient "within 15% of the viewport"
                 test is what made a slow scroll up impossible to escape from. A wheel can never land
                 short — the notch clamps at the bottom — but a thumb drag stopping a few pixels above it
                 can, and this is what keeps "I can't get following back" impossible by construction
                 rather than by picking a forgiving threshold.

                 Overlays the transcript's bottom edge rather than taking a row, so it never reflows the
                 conversation as it comes and goes. It sits OUTSIDE the ZoomTransform on purpose: it acts
                 on the view rather than being part of the conversation, so by the pane's rule it is
                 chrome and follows the environment font, not Ctrl+MouseWheel.

                 Bottom-RIGHT, with a right margin that clears the transcript's vertical scrollbar so the
                 pill never sits on the thumb. The margin is in unscaled units while the scrollbar lives
                 under the zoom transform, so a heavily zoomed pane can narrow that gap — it stays clear
                 at ordinary zoom levels, and an overlap would cost overlap, not function (the scrollbar
                 is still grabbable above and below a pill this small). -->
            <Button x:Name="JumpToLatestButton" Grid.Row="1"
                    Style="{StaticResource Chat.ChipButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,10"
                    Click="JumpToLatest_Click"
                    ToolTip="Scroll to the newest message and resume following"
                    AutomationProperties.Name="Latest message"
                    Visibility="{Binding ShowJumpToLatest,
                                 RelativeSource={RelativeSource AncestorType=views:ChatView},
                                 Converter={StaticResource BoolToVisible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Latest message" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- "Typing" indicator: an assistant-styled bubble with animated dots, shown while the
                 agent is working but not actively streaming text (like a chat app). It sits OUTSIDE the
                 virtualised list (its own Auto row) because it is driven by a view-model flag rather
                 than being a transcript item, and folding it into the list's scrolled content would
                 have meant wrapping the ItemsPresenter in a StackPanel — reintroducing the infinite
                 measure that defeats virtualisation. Visually it still reads as the last thing in the
                 conversation: the transcript auto-scrolls to the end whenever it appears.

                 Accent dots rather than the three faint grey ones it started as, in a FULL-WIDTH bar
                 rather than a shrink-wrapped bubble. Three subtle dots were legible inline at the end of
                 the transcript, where the eye already was; pinned to their own row they are the only
                 moving thing in an otherwise static pane and easy to miss. Widening the bar is what
                 replaces the label as the thing that catches the eye — it gives the row a definite
                 edge-to-edge presence, and stacked directly above the equally wide message box it reads
                 as part of the input furniture rather than as a stray bubble adrift at the bottom.

                 Deliberately NO accent left edge: a one-sided BorderThickness against this CornerRadius
                 makes WPF trace the stroke around the rounded corners, so it renders as a curved sliver
                 hooking top and bottom rather than a clean vertical bar. Squaring the left corners would
                 fix the stroke but leave this the only non-rounded bubble in the pane. -->
            <Border x:Name="TypingIndicator" Grid.Row="2" Margin="6,4" Padding="9,7" CornerRadius="6"
                    LayoutTransform="{StaticResource ZoomTransform}"
                    Background="{DynamicResource Chat.AssistantBackground}">
                <!-- Visible for as long as the agent is working, by EITHER route (IsAgentWorking, so the
                     steered out-of-turn window counts) — not merely while it is between messages. It now
                     carries Stop, and an escape hatch that comes and goes as the agent starts and stops
                     emitting text is not an escape hatch. The dots keep the narrower rule; see below.
                     This bar is the only thing on screen reporting "working", so it is also the only
                     honest place for the control that ends it. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAgentWorking}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left-aligned inside the full-width bar so the dots start where message content
                         does, rather than floating in the middle of an otherwise empty strip.
                         Hidden — not collapsed — when not typing, so the bar keeps one height for the
                         whole turn instead of resizing every time the agent starts or stops emitting
                         text, which would make Stop a moving target.
                         Still hidden while a permission prompt is up: the agent is BLOCKED on the user
                         then, not working, so animated dots are both noise beside the thing actually
                         asking for a decision and a small lie about what is happening. That objection was
                         always about the DOTS rather than the bar, which is why only they keep the
                         condition — the bar stays, carrying the Stop that a user who wants none of this
                         needs. MultiDataTrigger rather than a converter because the rule is "typing AND
                         nothing pending", not a property of either one. -->
                    <StackPanel x:Name="TypingDots" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAgentTyping}" Value="True" />
                                            <Condition Binding="{Binding HasPendingPermission}" Value="False" />
                                            <!-- And down for the same reason while a resume banner is up
                                                 (issue #84): a send parked on "couldn't summarize" holds
                                                 IsBusy, but nothing is generating — we are waiting on the
                                                 user, so animated dots would be the same small lie. -->
                                            <Condition Binding="{Binding HasPendingResume}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel.Resources>
                            <Style TargetType="Ellipse">
                                <Setter Property="Width" Value="5" />
                                <Setter Property="Height" Value="5" />
                                <Setter Property="Margin" Value="2,0" />
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Fill" Value="{DynamicResource Chat.AccentBackgroundHover}" />
                            </Style>
                        </StackPanel.Resources>
                        <!-- The dots' animation is started and STOPPED in the code-behind, keyed on this
                             panel's own IsVisible, and that is a measured fix rather than a refactor
                             (issue #86). It began on FrameworkElement.Loaded with RepeatBehavior=Forever
                             and nothing ever stopped it: hiding an element does not stop its animation
                             clock, so from the moment the chat view loaded WPF ran its animated render
                             loop for the life of the window - ~120 render operations a SECOND on a pane
                             doing nothing (measured, [dispatch] idle windows: Render:613 ops per 5s).
                             Invisible at idle, where each pass costs 0.04ms with nothing dirty; during a
                             scrollbar drag those same forced passes each carry the whole dirty transcript
                             and came to ~1.44s of an 11.3s gesture. Keyed on IsVisible rather than on the
                             view-model so it cannot drift from the trigger above that does the hiding. -->
                        <Ellipse x:Name="TDot1" />
                        <Ellipse x:Name="TDot2" />
                        <Ellipse x:Name="TDot3" />
                    </StackPanel>

                    <!-- Stop, on the right of the bar that already says the agent is working, rather than
                         in the composer where it shared a slot with Send.
                         Deliberately visible while a permission prompt is up, unlike the dots: "stop
                         altogether" is a legitimate answer to being asked for permission, and Deny is not
                         that answer — Deny refuses one action and lets the agent carry on and try another.
                         Removing it here would also have been a regression, not a new gap: CancelAsync
                         already resolves every queued request as cancelled before cancelling the turn,
                         precisely so this is reachable mid-prompt. -->
                    <Button Grid.Column="1" Command="{Binding StopCommand}" Style="{StaticResource Chat.IconButton}"
                            Width="22" Height="22" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Stop">
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource Chat.ErrorForeground}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Held messages (issue #70): what the user typed while the agent was working, waiting for
                 its release point. Directly under the working bar and directly above the message box —
                 between the thing that says the agent is busy and the thing that caused the wait, which
                 is also the order they happen in.

                 Content, so inside ZoomTransform: these are the user's own words awaiting delivery, and
                 they should be as legible as the message they'll become.

                 Each message is a ROW with an action area, not a line of text. Send-now and remove are
                 here now; editing in place and holding one message back out of the next batch are the
                 next two things it has to carry, and both want the same anchor on the right. -->
            <Border Grid.Row="3" Margin="6,0,6,4" Padding="9,6" CornerRadius="6"
                    LayoutTransform="{StaticResource ZoomTransform}"
                    Background="{DynamicResource Chat.EditBackground}"
                    BorderBrush="{DynamicResource Chat.Border}" BorderThickness="1"
                    Visibility="{Binding HasPendingMessages, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <!-- The wait is the whole feature, so it says what it is waiting for. "Waiting" with
                         no object reads as a hang, and this is the one surface that knows the answer.
                         The mode sits beside it because it is the same fact stated as a setting: the
                         sentence says WHEN these go, the button changes it. One control for the tray,
                         not one per message - per-message urgency implies an order a joined batch
                         cannot express. Named as Kiro names its two follow-up modes. -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PendingStatus}" FontSize="11"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Chat.SubtleForeground}" />
                        <!-- A chip, not a subtle label: this was styled as quiet text and read as a
                             status word rather than a control - the first thing anyone asked about it
                             was what it was for. Chat.ChipButton carries a border, a background, a hand
                             cursor and a hover accent, and is already themed and VS-mapped (the
                             jump-to-latest button uses it), so this needs no new theme keys. The
                             chevron says it changes; the sentence to its left says what it changes. -->
                        <!-- ...and the chevron now DROPS DOWN, because it said it would. It was a flip:
                             one control cycling two states behind a glyph that promises a list, so the
                             only way to find out what the other value was called was to change the
                             setting. A menu shows both, marks the one in force, and gives each the
                             sentence it needs - "Steer" and "Queue" are Kiro's words, not self-evident
                             ones, and a tooltip explaining them arrives after the user has already had
                             to guess. Two values is a thin menu, but the affordance has to be honest and
                             the labels have to be readable side by side. Space/Enter reaches the same
                             menu, because a Button raises Click for both - so there is one behaviour to
                             learn, not a click that lists and a key that cycles. -->
                        <Button x:Name="PendingReleaseButton" Grid.Column="1"
                                Click="PendingReleaseButton_Click"
                                Style="{StaticResource Chat.ChipButton}"
                                Margin="8,0,0,0" Padding="9,2"
                                ToolTip="When the held messages go">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Steer — send at the agent's next safe point"
                                              IsCheckable="True"
                                              IsChecked="{Binding PendingReleaseIsNextStep, Mode=OneWay}"
                                              Command="{Binding UseNextStepReleaseCommand}" />
                                    <MenuItem Header="Queue — send when the turn ends"
                                              IsCheckable="True"
                                              IsChecked="{Binding PendingReleaseIsTurnEnd, Mode=OneWay}"
                                              Command="{Binding UseTurnEndReleaseCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PendingReleaseLabel}" VerticalAlignment="Center" />
                                <Path Data="M0,0 L3.5,3.5 L7,0" StrokeThickness="1.3"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Margin="6,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Send now. Tray-wide, like the mode beside it, and for the same two reasons:
                             per-message urgency implies an order a joined batch cannot express, and it
                             could not be honoured evenly anyway — without steering the delivery rides
                             the turn-end release, which takes the whole tray, so "just this one" sent
                             one message on Claude and every message on Kiro for the same gesture. Red,
                             and the composer's own send glyph: the same act, except this one interrupts,
                             which measurably destroys the call in flight. -->
                        <Button Grid.Column="2" Command="{Binding SendPendingNowCommand}"
                                Style="{StaticResource Chat.IconButton}"
                                Width="22" Height="22" Margin="6,0,0,0"
                                ToolTip="Send now, interrupting whatever the agent is doing">
                            <Path Data="M8,3 L13,9 L9.5,9 L9.5,14 L6.5,14 L6.5,9 L3,9 Z"
                                  Stretch="Uniform" Width="10" Height="10"
                                  Fill="{DynamicResource Chat.ErrorForeground}" />
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PendingMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <!-- Two lines maximum: the tray is a waiting area, not a second
                                             transcript, and a pasted stack trace must not push the composer
                                             off the pane. The full text is in the tooltip. -->
                                        <TextBlock Text="{Binding Text}" FontSize="12"
                                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Top"
                                                   ToolTip="{Binding Text}"
                                                   Foreground="{DynamicResource Chat.Foreground}" />

                                        <!-- A held message can carry images too, and the tray has to show
                                             them: an attachment is the part of a waiting message the user
                                             is least able to reconstruct from memory, and the strip is
                                             where they would look to check it is still coming. -->
                                        <ItemsControl ItemsSource="{Binding Contexts}" Margin="0,2,0,0"
                                                      ItemTemplate="{StaticResource Chat.ContextChip}"
                                                      Visibility="{Binding HasContexts, Converter={StaticResource BoolToVisible}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,2,0,0"
                                                      ItemTemplate="{StaticResource Chat.AttachmentChip}"
                                                      Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisible}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Removal is the one action that IS a message's own: dropping this
                                         one says nothing about when the others go. Urgency moved to the
                                         tray header, where it can be honoured identically on every
                                         backend. -->
                                    <Button Grid.Column="1" Command="{Binding RemoveCommand}"
                                            Style="{StaticResource Chat.IconButton}"
                                            Width="22" Height="22" Margin="2,0,0,0" VerticalAlignment="Top"
                                            ToolTip="Don't send this">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   Foreground="{DynamicResource Chat.SubtleForeground}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Zoom readout: flashes the new percentage for ~1.5s on every zoom change (wheel or keyboard),
             then fades. Transient by design — Copilot Chat does the same, and a permanent indicator would
             be pure cost for anyone whose working default isn't 100%.
             CENTRED and large, again as Copilot does: a small pill in a corner was tried first and is too
             easy to miss, and moving it to a different corner would only relocate the miss. Overlaying the
             conversation is affordable precisely because it's transient.
             Overlays the transcript row as a SIBLING of the ScrollViewer, so it is deliberately OUTSIDE
             ZoomTransform: it is chrome reporting on the zoom, and must not scale with it. Hit-test
             transparent so it can never swallow a click or a wheel tick on the transcript beneath. -->
        <Border x:Name="ZoomFlash" Grid.Row="1" Opacity="0" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="18,10" CornerRadius="8"
                Background="{DynamicResource Chat.ToolBackground}"
                BorderBrush="{DynamicResource Chat.Border}" BorderThickness="1">
            <TextBlock x:Name="ZoomFlashText" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource Chat.Foreground}" />
        </Border>

        <!-- Resume choice: shown when a restored conversation can be resumed, offering full-context vs
             summary resume. Hidden while a permission prompt is up (they share this row). -->
        <Border Grid.Row="2" Padding="8,6"
                LayoutTransform="{StaticResource ZoomTransform}"
                Background="{DynamicResource Chat.EditBackground}"
                BorderBrush="{DynamicResource Chat.Border}" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasPendingResume}" Value="True" />
                                <Condition Binding="{Binding HasPendingPermission}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- Every button is optional, because this banner asks at three moments and they offer
                 different things: before the send it is full-vs-summary with a way out; after a summary
                 failed (issue #84) it is full-vs-fresh with none, the message being committed by then;
                 after the backend refused the reload (issue #268) it is summary-vs-fresh, also with
                 none. The heading and the fresh button's label are bound for the same reason — these
                 are not the same question, and by the third one the fresh session already exists. -->
            <StackPanel DataContext="{Binding PendingResume}">
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Chat.Foreground}" />
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="11"
                           Foreground="{DynamicResource Chat.SubtleForeground}" />
                <!-- The backend's own words, apart and in the error colour. Run into the muted
                     paragraph above it read as a footnote — the one failure in the text, set in the
                     quietest thing on the banner — while it is the fact being decided on. -->
                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                           Foreground="{DynamicResource Chat.ErrorForeground}"
                           Visibility="{Binding Reason, Converter={StaticResource NullToCollapsed}}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="{Binding FullLabel}" Command="{Binding ResumeFullCommand}"
                            Margin="0,0,6,0" MinWidth="72" Style="{StaticResource Chat.SubtleButton}"
                            Visibility="{Binding AllowFull, Converter={StaticResource BoolToVisible}}"
                            ToolTip="{Binding FullTooltip}" />
                    <Button Content="Resume from summary" Command="{Binding ResumeSummaryCommand}"
                            MinWidth="72" Style="{StaticResource Chat.SubtleButton}"
                            Visibility="{Binding AllowSummary, Converter={StaticResource BoolToVisible}}"
                            ToolTip="{Binding SummaryTooltip}" />
                    <Button Content="{Binding FreshLabel}" Command="{Binding ResumeFreshCommand}"
                            MinWidth="72" Style="{StaticResource Chat.SubtleButton}"
                            Visibility="{Binding AllowFresh, Converter={StaticResource BoolToVisible}}"
                            ToolTip="{Binding FreshTooltip}" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0,0,0"
                            MinWidth="56" Style="{StaticResource Chat.SubtleButton}"
                            Visibility="{Binding AllowCancel, Converter={StaticResource BoolToVisible}}"
                            Foreground="{DynamicResource Chat.SubtleForeground}" ToolTip="Don't send — put the message back" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Permission prompt: an inline banner above the input, not a modal dialog -->
        <Border Grid.Row="2" Padding="8,6"
                LayoutTransform="{StaticResource ZoomTransform}"
                Background="{DynamicResource Chat.EditBackground}"
                Visibility="{Binding HasPendingPermission, Converter={StaticResource BoolToVisible}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Chat.Border}" />
                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                    <Style.Triggers>
                        <!-- A sensitive (always-prompt) match gets a full red outline to break auto-pilot. -->
                        <DataTrigger Binding="{Binding PendingPermission.IsFlagged}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Chat.ErrorForeground}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel DataContext="{Binding PendingPermission}">
                <!-- Whose request this is, when the live session's conversation is not the one on screen
                     (issue #256). Above the title, because the first question a prompt over an unrelated
                     transcript raises is not "allow?" but "what is this doing here?". -->
                <TextBlock Text="{Binding Origin}" TextWrapping="Wrap" Margin="0,0,0,3" FontSize="11"
                           Foreground="{DynamicResource Chat.Foreground}"
                           Visibility="{Binding HasOrigin, Converter={StaticResource BoolToVisible}}" />
                <!-- Which agent WITHIN the conversation is asking, when it is a sub-agent: named by its
                     launching row where parentage is known, unnamed on Kiro v2. Same place and tone as
                     the origin - it answers the same "what is this?" question one level down. -->
                <TextBlock Text="{Binding Subagent}" TextWrapping="Wrap" Margin="0,0,0,3" FontSize="11"
                           Foreground="{DynamicResource Chat.Foreground}"
                           Visibility="{Binding HasSubagent, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Chat.Foreground}" />
                <!-- A rule that was withheld (a wildcard over a shell operator): which one and why, in
                     the subtle tone. Deliberately NOT the red call-out below - this is an ordinary
                     request, and red here would train the click-through red exists to prevent. -->
                <TextBlock Text="{Binding RuleNote}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="11"
                           Foreground="{DynamicResource Chat.SubtleForeground}"
                           Visibility="{Binding HasRuleNote, Converter={StaticResource BoolToVisible}}" />
                <!-- Sensitive-command call-out: names the matched text in red so the user sees WHY this stopped. -->
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" FontSize="11"
                           Foreground="{DynamicResource Chat.Foreground}"
                           Visibility="{Binding IsFlagged, Converter={StaticResource BoolToVisible}}">
                    <Run Text="{Binding FlaggedLabel, Mode=OneWay}" />
                    <Run Text="{Binding FlaggedFragment, Mode=OneWay}" FontWeight="Bold"
                         Foreground="{DynamicResource Chat.ErrorForeground}" />
                </TextBlock>
                <!-- The agent's stated "why", for any request kind, rendered exactly as the transcript rows
                     render it. A prefixed "Agent's stated reason:" label was tried and REMOVED (user,
                     2026-08-19): it read as boilerplate on every prompt, and the same prose already
                     appears unlabelled on the row beside the banner, so labelling it here alone implied a
                     distinction that does not exist. The attribution argument it was serving is real —
                     this is a decision surface and the text is the agent's own claim, which a
                     prompt-injected agent controls — but the protections carrying that weight are
                     structural rather than typographic, and all three remain: the command box below is
                     never shortened to make room, ClampIntent holds this to one line, and #131's guard
                     keeps a third party's "description" out of it entirely. -->
                <TextBlock Text="{Binding Intent}" TextWrapping="Wrap" Margin="0,3,0,0"
                           FontSize="11" FontStyle="Italic"
                           Foreground="{DynamicResource Chat.SubtleForeground}"
                           Visibility="{Binding HasIntent, Converter={StaticResource BoolToVisible}}" />
                <!-- The file a file-scoped request targets - always, row or no row, the way a
                     command request always shows its command. Relative to the agent's root; the
                     absolute path is the tooltip. -->
                <TextBlock Text="{Binding TargetPath}" ToolTip="{Binding TargetPathTooltip}"
                           TextWrapping="Wrap" Margin="0,3,0,0" FontSize="11"
                           FontFamily="{DynamicResource Chat.CodeFontFamily}"
                           Foreground="{DynamicResource Chat.Foreground}"
                           Visibility="{Binding HasTargetPath, Converter={StaticResource BoolToVisible}}" />
                <!-- The command/tool-input box: ONE shared chrome (border/background/padding/font/max-height,
                     defined here once) holding either a plain selectable TextBox (ordinary requests) or, for
                     a FLAGGED request, a TextBlock that highlights the sensitive fragment inline (a TextBox
                     can't colour a substring — the trade is no text selection while flagged). The font
                     inherits (TextElement.*) down to whichever child shows; the TextBlock also inherits the
                     foreground, but the TextBox needs it set explicitly — the VS theme's implicit TextBox
                     style sets its own Foreground, which beats ancestor inheritance and rendered the plain
                     command unreadable. Collapsed for an edit (its diff goes to "View diff"). -->
                <Border Margin="0,4,0,0" Padding="6,4" MaxHeight="160" BorderThickness="1"
                        BorderBrush="{DynamicResource Chat.Border}" Background="{DynamicResource Chat.InputBackground}"
                        TextElement.FontFamily="{DynamicResource Chat.CodeFontFamily}" TextElement.FontSize="11"
                        TextElement.Foreground="{DynamicResource Chat.Foreground}"
                        Visibility="{Binding HasCommandDisplay, Converter={StaticResource BoolToVisible}}">
                    <Grid>
                        <TextBox Text="{Binding DisplayDetail, Mode=OneWay}"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 BorderThickness="0" Padding="0" Background="Transparent"
                                 Foreground="{DynamicResource Chat.Foreground}"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding ShowCommandBox, Converter={StaticResource BoolToVisible}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ShowHighlightedCommand, Converter={StaticResource BoolToVisible}}">
                            <TextBlock TextWrapping="Wrap"
                                       controls:TextHighlighter.Source="{Binding DisplayDetail}"
                                       controls:TextHighlighter.Term="{Binding FlaggedFragment}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
                <!-- Edit prompt: open the change in the native diff viewer (old-on-disk vs proposed) so
                     it can be reviewed before approving. Hidden when there's no diff/viewer. -->
                <Button Content="View diff →" Command="{Binding ViewDiffCommand}"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"
                        Style="{StaticResource Chat.SubtleButton}"
                        Foreground="{DynamicResource Chat.LinkForeground}"
                        Visibility="{Binding CanViewDiff, Converter={StaticResource BoolToVisible}}" />

                <!-- "Show in transcript": the user's own route to the row being approved. Always offered,
                     and the ONLY route when they have scrolled away from the bottom - there we
                     deliberately do not move them, because they are looking at something particular and
                     yanking them off it is the thing issue #90 exists to prevent. While the transcript is
                     following, the pane is in "auto mode" and parks on the row by itself; this stays
                     visible even then, since a park can be scrolled away from.
                     Binds back past the banner's own DataContext (which is the request, not the VM). -->
                <Button Content="Show in transcript" Click="ShowPermissionTarget_Click"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"
                        Style="{StaticResource Chat.SubtleButton}"
                        Foreground="{DynamicResource Chat.LinkForeground}"
                        Visibility="{Binding DataContext.HasHighlightedItem,
                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                     Converter={StaticResource BoolToVisible}}" />

                <!-- Step 1: the option buttons (hidden while in the scope-edit or confirm sub-steps). -->
                <ItemsControl ItemsSource="{Binding Options}" Margin="0,6,0,0"
                              Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVisible}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayLabel}" ToolTip="{Binding Label}"
                                    Command="{Binding Command}"
                                    Margin="0,0,6,0" MinWidth="72"
                                    Style="{StaticResource Chat.PermissionOptionButton}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Step 2 (scoped "always" only): an editable glob — a command glob (default = the
                     full command; widenable, e.g. "git *") or a path glob for edits (default = the
                     file; the shortcuts widen to its folder) + opt-in to persist, confirmed with the
                     tick. -->
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding IsEditingAlways, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{Binding AlwaysLabel}" FontSize="11"
                               Foreground="{DynamicResource Chat.SubtleForeground}" />
                    <!-- Path-scope shortcuts (This file / This folder) rewrite the glob below. -->
                    <ItemsControl ItemsSource="{Binding ScopeChoices}" Margin="0,4,0,0"
                                  Visibility="{Binding HasScopeChoices, Converter={StaticResource BoolToVisible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding Command}"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource Chat.ChipButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" BorderThickness="1"
                                Background="{DynamicResource Chat.InputBackground}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- No border at rest; show the focus colour only while the caret is inside. -->
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Chat.InputBorderFocus}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <!-- Read-only for a TOOL rule: it names one tool exactly, so there is no
                                 scope to widen and an edit could only ever break the match. -->
                            <TextBox x:Name="CommandPatternBox" Padding="6,3" BorderThickness="0" Background="Transparent"
                                     IsReadOnly="{Binding IsPatternReadOnly}"
                                     Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Chat.CodeFontFamily}" FontSize="11"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource Chat.Foreground}"
                                     CaretBrush="{DynamicResource Chat.Foreground}"
                                     IsVisibleChanged="CommandPatternBox_IsVisibleChanged" />
                        </Border>
                        <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="32"
                                Command="{Binding ConfirmAlwaysCommand}" ToolTip="Confirm"
                                Style="{StaticResource Chat.SubtleButton}"
                                Foreground="{DynamicResource Chat.SuccessForeground}" FontWeight="Bold"
                                Content="&#xE73E;" FontFamily="Segoe MDL2 Assets" />
                        <Button Grid.Column="2" Margin="6,0,0,0" MinWidth="32"
                                Command="{Binding CancelAlwaysCommand}" ToolTip="Back"
                                Style="{StaticResource Chat.SubtleButton}"
                                Foreground="{DynamicResource Chat.ErrorForeground}" FontWeight="Bold"
                                Content="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                    </Grid>
                    <!-- What a wildcard grants, and what it never does - under a command glob only. -->
                    <TextBlock Text="{Binding PatternHint}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="10"
                               Foreground="{DynamicResource Chat.SubtleForeground}"
                               Visibility="{Binding HasPatternHint, Converter={StaticResource BoolToVisible}}" />
                    <!-- Allow rules can persist to config; deny rules are session-only, so this hides for a deny. -->
                    <CheckBox Content="Save this rule permanently" Margin="0,6,0,0" FontSize="11"
                              Visibility="{Binding CanPersist, Converter={StaticResource BoolToVisible}}"
                              IsChecked="{Binding PersistRemembered}"
                              Foreground="{DynamicResource Chat.SubtleForeground}" />
                </StackPanel>

                <!-- Step 3 (flagged "allow once" only): the anti-fat-finger confirm — a sensitive command
                     can be allowed once, but only after an explicit second confirmation. -->
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding IsConfirmingAllow, Converter={StaticResource BoolToVisible}}">
                    <!-- The rule/fragment is already called out above (persistent while flagged); this is
                         just the confirm question, so it doesn't repeat it. -->
                    <TextBlock Text="Really allow this once? It won't be remembered."
                               TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Chat.Foreground}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Allow once" Command="{Binding ConfirmFlaggedAllowCommand}"
                                Margin="0,0,6,0" MinWidth="72"
                                Style="{StaticResource Chat.PermissionOptionButton}" />
                        <Button Content="Cancel" Command="{Binding CancelFlaggedAllowCommand}"
                                MinWidth="56" Style="{StaticResource Chat.SubtleButton}"
                                Foreground="{DynamicResource Chat.SubtleForeground}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Input: rounded container, placeholder, icon send/stop. No border at rest; brightens to the
             focus colour while typing (same treatment as the command-rule field). -->
        <Border Grid.Row="3" Margin="6" Padding="6,4" CornerRadius="8" BorderThickness="1"
                LayoutTransform="{StaticResource ZoomTransform}"
                Background="{DynamicResource Chat.InputBackground}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Chat.InputBorderFocus}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sits in the container's top padding (negative margin) so the grab area is the box's
                     top edge, which is where the gesture is discoverable. -->
                <Thumb x:Name="InputResizeGrip" Grid.Row="0" Grid.ColumnSpan="2"
                       Style="{StaticResource Chat.InputResizeGrip}" Margin="0,-4,0,2"
                       DragStarted="InputGrip_DragStarted" DragDelta="InputGrip_DragDelta"
                       DragCompleted="InputGrip_DragCompleted"
                       MouseDoubleClick="InputGrip_MouseDoubleClick"
                       ToolTip="Drag to resize the message box (double-click to reset)" />

                <!-- What this message is carrying, waiting to be sent: pasted images (issue #118)
                     and attached IDE context (issue #73). Inside the input border and above the text,
                     so both read as part of the message being composed rather than as something that
                     has already happened. Nothing is written to disk until the message is sent, so
                     removing a chip here leaves no trace.

                     ONE strip visually, two ItemsControls structurally. Conceptually they are the same
                     thing - payload riding this message - so they belong on one row and must not
                     appear and disappear independently. Giving them one ItemsControl would mean a
                     shared base class under AttachmentViewModel, which is shipped and tested code, for
                     a purely cosmetic gain; the chip templates differ anyway (a thumbnail and a size
                     against a label and an expander). -->
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,4">
                    <!-- Deliberately a LIST rather than a "capture debug state" button. The gesture is
                         "add something to this message", and selection, the active file and a
                         diagnostics slice all belong under it later - so the shape is settled now,
                         while it costs nothing, rather than by adding a second button beside the
                         first. The menu's own opening re-reads what is available (see
                         ContextSourceViewModel.Refresh).

                         Always drawn, and so is this row: the menu's first item attaches an image
                         FILE, which every host offers because it needs no IDE behind it - the peer of
                         Ctrl+V, not of the debugger read. It used to be hidden where a host had
                         registered no context sources, which was right while the menu held nothing
                         else. -->
                    <!-- Top-aligned, or the WrapPanel stretches it to the height of the tallest thing
                         on the line - which is an EXPANDED context chip, so opening one turned the
                         button into a tall empty column with a word in the middle of it. -->
                    <Button x:Name="AddContextButton" Click="AddContextButton_Click"
                            Style="{StaticResource Chat.ChipButton}"
                            VerticalAlignment="Top"
                            Margin="0,0,6,4" Padding="8,2"
                            ToolTip="Attach an image or some IDE context to this message">
                        <Button.ContextMenu>
                            <!-- Built in code-behind from ContextSources: the menu is a list whose
                                 length is a host's decision, and each item needs the source's own
                                 command and its availability. -->
                            <ContextMenu />
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Add" VerticalAlignment="Center" />
                            <Path Data="M0,0 L3.5,3.5 L7,0" StrokeThickness="1.3"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Margin="6,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ItemsControl ItemsSource="{Binding PendingContexts}"
                                  ItemTemplate="{StaticResource Chat.ContextChip}"
                                  Visibility="{Binding HasPendingContexts, Converter={StaticResource BoolToVisible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding PendingAttachments}"
                                  ItemTemplate="{StaticResource Chat.AttachmentChip}"
                                  Visibility="{Binding HasPendingAttachments, Converter={StaticResource BoolToVisible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </WrapPanel>

                <Grid Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                    <!-- MinHeight/MaxHeight are owned by the code-behind (ChatView.UpdateInputBoxSize):
                         the dragged height is a floor, content still grows the box above it, and both
                         are re-clamped against the pane. -->
                    <TextBox x:Name="InputBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="13"
                             Background="Transparent" BorderThickness="0" Padding="2,2"
                             Foreground="{DynamicResource Chat.Foreground}"
                             CaretBrush="{DynamicResource Chat.Foreground}"
                             PreviewKeyDown="InputBox_PreviewKeyDown"
                             ToolTip="Pasted terminal output is cleaned of escape codes. Ctrl+Shift+V pastes it verbatim." />
                    <!-- Placeholder hides on focus too (not just when there's text), so it never
                         overlaps the caret of an empty, focused box. -->
                    <TextBlock Text="Ask the agent…  (Enter to send, Shift+Enter for newline)"
                               Margin="4,2,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                               FontSize="13" Foreground="{DynamicResource Chat.SubtleForeground}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding InputText}" Value="" />
                                            <Condition Binding="{Binding IsKeyboardFocused, ElementName=InputBox}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Send ONLY. Stop moved to the working bar above (TypingIndicator).
                     The two act on different objects with different lifetimes — Send on the text in this
                     box, Stop on the turn in flight — and the single-slot pattern they used to share is
                     borrowed from chat UIs where sending mid-turn is impossible, so the slot is free while
                     busy. Steering broke that premise: Enter steers mid-turn while the button in the same
                     corner cancelled, so the keyboard and the mouse disagreed and the mouse was the
                     destructive one. It also had the two halves reading different state (visibility on
                     IsBusy, StopCommand's CanExecute on IsAgentWorking), which is how Stop came to be
                     hidden for the whole steered window while its command was live.
                     Always visible, disabled by SendCommand when there is nothing to send or the backend
                     can't take one mid-turn — a control that greys out teaches what it wants; one that
                     vanishes teaches nothing. -->
                <Grid Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" Margin="4,0,0,0">
                    <Button Command="{Binding SendCommand}" Style="{StaticResource Chat.AccentButton}"
                            Width="30" Height="30" Padding="6" ToolTip="Send (Enter)">
                        <Path Data="M9,3 L15,9 L11,9 L11,16 L7,16 L7,9 L3,9 Z" Stretch="Uniform"
                              Width="13" Height="13" Fill="{DynamicResource Chat.AccentForeground}" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Status strip: ambient session state, at the bottom of the pane where VS Code's chat puts it.
             Chrome, so deliberately OUTSIDE ZoomTransform — it reports on the conversation rather than
             being part of it, and stays legible at any zoom.
             The permission picker lives here rather than in the header because this is where its banner
             appears; the context ring is right-aligned, mirroring every product that shows one. -->
        <Border x:Name="StatusStrip" Grid.Row="4" Padding="6,3" BorderThickness="0,1,0,0"
                Background="{DynamicResource Chat.Background}"
                BorderBrush="{DynamicResource Chat.Border}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <!-- MCP, inboard of the ring: the readouts about the BACKEND sit together at this
                         end, rather than the connection state reading as part of the permission combo
                         it would otherwise sit against. The cost is accepted knowingly - the ring is
                         Visibility-bound to HasUsage, so this button shifts left the first time a
                         backend reports a figure. That is one move, on a control whose own resting
                         width is fixed, and adjacency was judged worth it. -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- No explicit FontSize here or on the ring's label: the strip inherits the pane's
                     ambient size so it tracks VS's environment font. It was 11 (smaller than ambient),
                     copied from VS Code's strip without accounting for what it sits next to. -->
                <ComboBox x:Name="PermissionModePicker" Grid.Column="0" MinWidth="92" Padding="4,1"
                          ItemsSource="{Binding PermissionModes}" SelectedItem="{Binding SelectedPermissionMode}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="Permissions: how the agent's actions are approved" />

                <!-- MCP roster (issue #122). LEFT-aligned in the strip's spare column, deliberately: the
                     pending suffix changes width as servers connect, and right-aligning it would jog the
                     ring on every roster frame.
                     Unlike the ring this is NOT gated on the backend reporting something. It is a door,
                     not a light: it opens reference information about the user's own tooling that is
                     available nowhere else in the product, and on the backend that reports least it is
                     the only place that says so. That is also why the resting state is a bare glyph in
                     the subtle foreground with NO count, NO tick and NO colour — the moment its resting
                     appearance asserts health it becomes the always-on health light that issue #122
                     part 3 rejected, and for that rejection's own reason. -->
                <ToggleButton Grid.Column="2" x:Name="McpButton" Cursor="Hand" Padding="3,1"
                              Margin="0,0,6,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsMcpOpen, Mode=TwoWay}"
                              Visibility="{Binding CanShowMcpStatus, Converter={StaticResource BoolToVisible}}"
                              ToolTip="{Binding McpDetail}"
                              AutomationProperties.Name="MCP servers">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- The word, not an icon. Three reasons, in order of weight: an icon-font glyph renders as a box when the codepoint
                             is missing and no assertion can tell that from a real icon; a drawn plug is
                             unreadable at 11px and reads as an unrelated bracket; and the strip is
                             already text-forward ("21%", the permission picker), so a word is the
                             consistent choice as well as the unambiguous one. It also inherits the
                             environment font, so it tracks VS's text size like the rest of the chrome. -->
                        <TextBlock Text="MCP" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- The invariant is that the RESTING STATE MAY NOT ASSERT HEALTH,
                                         and its test is whether the appearance varies with connection
                                         state: no colour, no tick, no count. Tone is not one of those.
                                         This word is the same white whether five servers are up, none
                                         is, or every one of them is dead, so it says exactly what a
                                         subtle word said - nothing - and the always-on light issue #122
                                         part 3 rejected stays rejected. Bright because the strip has
                                         ONE tonal axis (the panels' own rule, one layer out): the ring's
                                         figure and the info glyph both read bright, so a subtle word
                                         beside them was the axis carrying a second job, and the job it
                                         had drifted into was implying this door was the inactive one. -->
                                    <Setter Property="Foreground" Value="{DynamicResource Chat.Foreground}" />
                                    <Style.Triggers>
                                        <!-- Accent, NOT the warning brush: a server still connecting is
                                             work in progress, not a fault, and no failure state has ever
                                             been captured on either engine. (Chat.WarningForeground is
                                             also not overridden in VsTheme, so it would not theme.) -->
                                        <DataTrigger Binding="{Binding McpIsPending}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Chat.AccentBackground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Bright for the same reason, and more plainly: "2 of 3" is a readout,
                             the one thing on this control that is actually saying something. -->
                        <TextBlock Text="{Binding McpPendingLabel}" Margin="5,0,2,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Chat.Foreground}"
                                   Visibility="{Binding McpPendingLabel, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </ToggleButton>

                <Popup Grid.Column="2" x:Name="McpPopup" PlacementTarget="{Binding ElementName=McpButton}"
                       Placement="Top" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                       IsOpen="{Binding IsMcpOpen, Mode=TwoWay}" MinWidth="260" MaxWidth="380">
                    <Border Background="{DynamicResource Chat.Background}" BorderBrush="{DynamicResource Chat.Border}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8,10,12" Margin="8,8,8,2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="MCP servers" FontWeight="SemiBold" Margin="0,0,0,0"
                                       Foreground="{DynamicResource Chat.Foreground}" />
                            <ItemsControl ItemsSource="{Binding McpRows}"
                                          ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Context-usage ring. Hidden entirely until a backend reports a figure: a ring stuck at
                     0% would imply "nothing used" for a backend that simply never says. Click opens the
                     detail panel; the tooltip previews the same figures for a glance. -->
                <ToggleButton Grid.Column="3" x:Name="UsageButton" Cursor="Hand" Padding="3,1"
                              IsChecked="{Binding IsUsageOpen, Mode=TwoWay}"
                              Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisible}}"
                              ToolTip="{Binding UsageDetail}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="13" Height="13" VerticalAlignment="Center">
                        <!-- Track, then the filled arc over it. Round caps so a 1% sliver still reads. -->
                        <Ellipse Width="11" Height="11" StrokeThickness="2"
                                 Stroke="{DynamicResource Chat.Border}" />
                        <Path StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{Binding ContextPercent, Converter={StaticResource PercentToArc}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{DynamicResource Chat.AccentBackground}" />
                                    <Style.Triggers>
                                        <!-- Not decoration: at these levels the backend is about to
                                             summarize or truncate the conversation. -->
                                        <DataTrigger Binding="{Binding UsageLevel}" Value="High">
                                            <Setter Property="Stroke" Value="{DynamicResource Chat.WarningForeground}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UsageLevel}" Value="Critical">
                                            <Setter Property="Stroke" Value="{DynamicResource Chat.ErrorForeground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                    <!-- Bright, like the values in the panels this button opens: one tonal axis,
                         one job. Subtle is reserved for headings and nesting, and this is a
                         readout - the same figure the usage panel's own rows carry. -->
                    <TextBlock Text="{Binding ContextLabel}" Margin="5,0,2,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Chat.Foreground}" />
                    </StackPanel>
                </ToggleButton>

                <!-- Usage detail. Same shape as the history picker: anchored to its button, closes on
                     click-away. Deliberately has NO "compact conversation" action — our summarize starts
                     a FRESH session with a recap rather than compacting in place, so a button here would
                     promise something the backend does differently (Kiro compacts itself at 80%). -->
                <Popup Grid.Column="3" x:Name="UsagePopup" PlacementTarget="{Binding ElementName=UsageButton}"
                       Placement="Top" HorizontalOffset="-160"
                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                       IsOpen="{Binding IsUsageOpen, Mode=TwoWay}" MinWidth="240" MaxWidth="340">
                    <Border Background="{DynamicResource Chat.Background}" BorderBrush="{DynamicResource Chat.Border}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="8,8,8,2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4" />
                        </Border.Effect>
                        <StackPanel>
                            <!-- "Usage", not "Session usage": most rows are session-scoped, but a rate
                                 limit is ACCOUNT-scoped and spans sessions, so the heading must not
                                 claim a scope for it. Each row that isn't session-scoped says so itself. -->
                            <TextBlock Text="Usage" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource Chat.Foreground}" />

                            <!-- Same fill as the ring, read as a bar: easier to judge against the
                                 thresholds listed in the rows below. -->
                            <ProgressBar Height="4" Margin="0,0,0,8" Minimum="0" Maximum="100"
                                         Value="{Binding ContextPercent, Mode=OneWay}"
                                         Background="{DynamicResource Chat.Border}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Foreground" Value="{DynamicResource Chat.AccentBackground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsageLevel}" Value="High">
                                                <Setter Property="Foreground" Value="{DynamicResource Chat.WarningForeground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UsageLevel}" Value="Critical">
                                                <Setter Property="Foreground" Value="{DynamicResource Chat.ErrorForeground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                                <!-- Flat template: the stock one brings its own gradients and border,
                                     which fight every VS theme. PART_Track/PART_Indicator are the named
                                     parts the control positions itself, so the fill needs no width maths. -->
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                            <Border x:Name="PART_Track" />
                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2"
                                                    Background="{TemplateBinding Foreground}" />
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>

                            <ItemsControl ItemsSource="{Binding UsageRows}"
                                          ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Session information (issue #160): what this session actually negotiated, which is
                 invisible everywhere else. It lives in the status strip rather than the header
                 because the header row is VERBS - History, New and Share each do something, and the
                 two combos change the session - while this changes nothing and is read and
                 dismissed. The strip is where the pane's other readouts already are, and the usage
                 ring beside it is the same interaction: a small control opening a read-only card.
                 OUTBOARD of the ring deliberately: the ring is Visibility-bound to HasUsage, so an
                 always-present control placed inboard of it would shift sideways the moment a
                 backend first reported a figure. E946 is Info; a wrong codepoint renders as a box,
                 so this one is settled by the screenshot-session-info mode, never by assertion. -->
                <ToggleButton Grid.Column="4" x:Name="SessionInfoButton" Margin="6,0,0,0" Cursor="Hand"
                              IsChecked="{Binding IsSessionInfoOpen, Mode=TwoWay}"
                              ToolTip="Session information">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="5,3">
                                <!-- 12, not the header's 14: E946's circle fills most of its em box,
                                     so at 14 it drew visibly larger than the ring's fixed 11px circle
                                     next to it. The size is chosen for the NEIGHBOUR rather than for
                                     the icon set - in the header it matched History and Share, and it
                                     no longer keeps that company. Settled from the strip crop of
                                     screenshot-session-info-header.png, which is also why that shot
                                     now drives the turn to completion: parked at a permission banner
                                     the ring never renders, and the pairing cannot be seen at all. -->
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource Chat.Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Chat.HoverBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- A Popup, not a ContextMenu: a menu closes on any click inside it, and this panel
                     exists to be selected from and pasted into a bug report (issue #82's lesson).
                     Scrollable, because the log rows and a long working directory can outgrow it. -->
                <Popup Grid.Column="4" x:Name="SessionInfoPopup" PlacementTarget="{Binding ElementName=SessionInfoButton}"
                       Placement="Top" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                       IsOpen="{Binding IsSessionInfoOpen, Mode=TwoWay}" MinWidth="300" MaxWidth="420">
                    <Border Background="{DynamicResource Chat.Background}" BorderBrush="{DynamicResource Chat.Border}"
                            BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,2,8,8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4" />
                        </Border.Effect>
                        <DockPanel MaxHeight="420">
                            <Grid DockPanel.Dock="Top" Margin="6,4,6,6">
                                <TextBlock Text="Session" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Chat.Foreground}" />
                                <!-- One gesture for the whole block. The label flips to "Copied"
                                     because a clipboard write is otherwise invisible, and this
                                     panel is not the transcript so it cannot say so there. -->
                                <Button HorizontalAlignment="Right" Cursor="Hand"
                                        Style="{StaticResource Chat.ChipButton}"
                                        Command="{Binding SessionInfo.CopyCommand}"
                                        Content="{Binding SessionInfo.CopyLabel}"
                                        ToolTip="Copy these details for a bug report" />
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SessionInfo.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DetailRow}">
                                            <Grid Margin="6,1" ToolTip="{Binding Tooltip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="label" Grid.Column="0" Text="{Binding Label}"
                                                           Margin="0,0,8,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Chat.Foreground}" />
                                                <!-- Wraps rather than clips: absolute paths are the
                                                     longest strings this pane puts in a fixed-width
                                                     card, and a truncated path is not a path. -->
                                                <TextBlock x:Name="value" Grid.Column="1" Text="{Binding Value}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Chat.Foreground}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMonospace}" Value="True">
                                                    <Setter TargetName="value" Property="FontFamily"
                                                            Value="{DynamicResource Chat.CodeFontFamily}" />
                                                </DataTrigger>
                                                <!-- Dims the VALUE, which is the opposite of
                                                     DetailRowTemplate (label) and is CORRECT here: this
                                                     panel's sub-rows are the log rows, whose labels are
                                                     deliberately EMPTY with the indent alone carrying
                                                     them, so dimming the label dims nothing and the rows
                                                     lose their only mark of being detail under "Logs".
                                                     The templates differ in tone because they differ in
                                                     ROW SHAPE - the same reason they differ in column
                                                     layout. Converged onto the label once, on a grep for
                                                     Depth that missed every `isSubItem: true` caller and
                                                     read as dead code; it is not dead, and the regression
                                                     is INVISIBLE TO EVERY CHECK because an empty label
                                                     renders nothing either way. -->
                                                <DataTrigger Binding="{Binding IsSubItem}" Value="True">
                                                    <Setter TargetName="label" Property="Margin" Value="12,0,8,0" />
                                                    <Setter TargetName="value" Property="Foreground"
                                                            Value="{DynamicResource Chat.SubtleForeground}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</UserControl>
