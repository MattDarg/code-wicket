// The placeholder site at code-wicket.dev: a Worker serving static assets.
// Deploy with `npx wrangler deploy` from this folder (after `npx wrangler login`).
{
  "name": "code-wicket-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-13",
  // Served only on our own domains; no *.workers.dev or preview hostnames.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs and Traces; `traces.enabled` is separate from the top-level switch.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs on every request so it can redirect the aliases and stamp headers.
    "run_worker_first": true
  },
  // Custom Domains: wrangler creates the DNS records and certificates. Each zone must be
  // active on the account and the hostname must not already carry a CNAME.
  "routes": [
    { "pattern": "code-wicket.dev", "custom_domain": true },
    { "pattern": "www.code-wicket.dev", "custom_domain": true },
    { "pattern": "code-wicket.com", "custom_domain": true },
    { "pattern": "www.code-wicket.com", "custom_domain": true }
  ]
}
